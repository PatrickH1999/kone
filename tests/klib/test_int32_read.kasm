// test_int32_read: checks klib's int32_read against the keystrokes in
// tests/klib/test_int32_read.in, which the harness pipes into the vm:
//     '12345 '      -> 12345
//     '-42 '        -> -42
//     '1.234.567 '  -> 1234567, the separators dropped
//     '12<DEL>3 '   -> 13, the backspace dropping a digit
//     '7x'          -> 'x' left in R14 as the terminator
//
// The echo of every keystroke is what the first display rows are made of. The
// expected value goes to R4 - R7 before the call, which int32_read preserves.
// The failure count lives at 0x8040, as int32_read clobbers R12 - R15.

    JMP main

.include "../../klib/io/disp.kasm"
.include "../../klib/math/int32.kasm"
.include "../../klib/io/int32_read.kasm"

main:
    LDI 0
    STM 0x8040      // number of failed cases

    LDI 0x39
    STR 4
    LDI 0x30
    STR 5
    LDI 0x00
    STR 6
    LDI 0x00
    STR 7           // 12345
    CLL int32_read
    CLL check_a
    JA0 main__int32_read_plain_pass
    LDM 0x8040
    STR 12
    LDI 1
    ADD 12
    STM 0x8040      // one more failed case
    CLL print_fail
    JMP main__int32_read_plain_name
main__int32_read_plain_pass:
    CLL print_pass
main__int32_read_plain_name:
    LDI 105         // 'i'
    CLL disp_putc
    LDI 110         // 'n'
    CLL disp_putc
    LDI 116         // 't'
    CLL disp_putc
    LDI 51          // '3'
    CLL disp_putc
    LDI 50          // '2'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 114         // 'r'
    CLL disp_putc
    LDI 101         // 'e'
    CLL disp_putc
    LDI 97          // 'a'
    CLL disp_putc
    LDI 100         // 'd'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 112         // 'p'
    CLL disp_putc
    LDI 108         // 'l'
    CLL disp_putc
    LDI 97          // 'a'
    CLL disp_putc
    LDI 105         // 'i'
    CLL disp_putc
    LDI 110         // 'n'
    CLL disp_putc
    CLL disp_nl

    LDI 0xD6
    STR 4
    LDI 0xFF
    STR 5
    LDI 0xFF
    STR 6
    LDI 0xFF
    STR 7           // -42
    CLL int32_read
    CLL check_a
    JA0 main__int32_read_neg_pass
    LDM 0x8040
    STR 12
    LDI 1
    ADD 12
    STM 0x8040      // one more failed case
    CLL print_fail
    JMP main__int32_read_neg_name
main__int32_read_neg_pass:
    CLL print_pass
main__int32_read_neg_name:
    LDI 105         // 'i'
    CLL disp_putc
    LDI 110         // 'n'
    CLL disp_putc
    LDI 116         // 't'
    CLL disp_putc
    LDI 51          // '3'
    CLL disp_putc
    LDI 50          // '2'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 114         // 'r'
    CLL disp_putc
    LDI 101         // 'e'
    CLL disp_putc
    LDI 97          // 'a'
    CLL disp_putc
    LDI 100         // 'd'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 110         // 'n'
    CLL disp_putc
    LDI 101         // 'e'
    CLL disp_putc
    LDI 103         // 'g'
    CLL disp_putc
    CLL disp_nl

    LDI 0x87
    STR 4
    LDI 0xD6
    STR 5
    LDI 0x12
    STR 6
    LDI 0x00
    STR 7           // 1234567
    CLL int32_read
    CLL check_a
    JA0 main__int32_read_sep_pass
    LDM 0x8040
    STR 12
    LDI 1
    ADD 12
    STM 0x8040      // one more failed case
    CLL print_fail
    JMP main__int32_read_sep_name
main__int32_read_sep_pass:
    CLL print_pass
main__int32_read_sep_name:
    LDI 105         // 'i'
    CLL disp_putc
    LDI 110         // 'n'
    CLL disp_putc
    LDI 116         // 't'
    CLL disp_putc
    LDI 51          // '3'
    CLL disp_putc
    LDI 50          // '2'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 114         // 'r'
    CLL disp_putc
    LDI 101         // 'e'
    CLL disp_putc
    LDI 97          // 'a'
    CLL disp_putc
    LDI 100         // 'd'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 115         // 's'
    CLL disp_putc
    LDI 101         // 'e'
    CLL disp_putc
    LDI 112         // 'p'
    CLL disp_putc
    CLL disp_nl

    LDI 0x0D
    STR 4
    LDI 0x00
    STR 5
    LDI 0x00
    STR 6
    LDI 0x00
    STR 7           // 13
    CLL int32_read
    CLL check_a
    JA0 main__int32_read_bs_pass
    LDM 0x8040
    STR 12
    LDI 1
    ADD 12
    STM 0x8040      // one more failed case
    CLL print_fail
    JMP main__int32_read_bs_name
main__int32_read_bs_pass:
    CLL print_pass
main__int32_read_bs_name:
    LDI 105         // 'i'
    CLL disp_putc
    LDI 110         // 'n'
    CLL disp_putc
    LDI 116         // 't'
    CLL disp_putc
    LDI 51          // '3'
    CLL disp_putc
    LDI 50          // '2'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 114         // 'r'
    CLL disp_putc
    LDI 101         // 'e'
    CLL disp_putc
    LDI 97          // 'a'
    CLL disp_putc
    LDI 100         // 'd'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 98          // 'b'
    CLL disp_putc
    LDI 115         // 's'
    CLL disp_putc
    CLL disp_nl

    CLL int32_read
    LDR 14          // the terminator
    STR 12
    LDI 136         // 256 - 120
    ADD 12
    JA0 main__int32_read_term_pass
    LDM 0x8040
    STR 12
    LDI 1
    ADD 12
    STM 0x8040      // one more failed case
    CLL print_fail
    JMP main__int32_read_term_name
main__int32_read_term_pass:
    CLL print_pass
main__int32_read_term_name:
    LDI 105         // 'i'
    CLL disp_putc
    LDI 110         // 'n'
    CLL disp_putc
    LDI 116         // 't'
    CLL disp_putc
    LDI 51          // '3'
    CLL disp_putc
    LDI 50          // '2'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 114         // 'r'
    CLL disp_putc
    LDI 101         // 'e'
    CLL disp_putc
    LDI 97          // 'a'
    CLL disp_putc
    LDI 100         // 'd'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 116         // 't'
    CLL disp_putc
    LDI 101         // 'e'
    CLL disp_putc
    LDI 114         // 'r'
    CLL disp_putc
    LDI 109         // 'm'
    CLL disp_putc
    CLL disp_nl

main__summary:
    LDM 0x8040
    JA0 main__all_pass
    STR 12
    LDI 48          // '0'
    ADD 12          // at most one digit, there are fewer than ten cases
    CLL disp_putc
    LDI 32          // ' '
    CLL disp_putc
    LDI 70          // 'F'
    CLL disp_putc
    LDI 65          // 'A'
    CLL disp_putc
    LDI 73          // 'I'
    CLL disp_putc
    LDI 76          // 'L'
    CLL disp_putc
    LDI 69          // 'E'
    CLL disp_putc
    LDI 68          // 'D'
    CLL disp_putc
    CLL disp_nl
    JMP main__halt

main__all_pass:
    LDI 65          // 'A'
    CLL disp_putc
    LDI 76          // 'L'
    CLL disp_putc
    LDI 76          // 'L'
    CLL disp_putc
    LDI 32          // ' '
    CLL disp_putc
    LDI 80          // 'P'
    CLL disp_putc
    LDI 65          // 'A'
    CLL disp_putc
    LDI 83          // 'S'
    CLL disp_putc
    LDI 83          // 'S'
    CLL disp_putc
    CLL disp_nl

main__halt:
    JMP main__halt

// check_a: compares the value in R0 - R3 against the expected value in R4 - R7
//     out:      accumulator = 0 if the two are equal
//     clobbers: R12
check_a:
    LDR 0
    XOR 4
    STR 12
    LDR 1
    XOR 5
    ORR 12
    STR 12
    LDR 2
    XOR 6
    ORR 12
    STR 12
    LDR 3
    XOR 7
    ORR 12
    RET

// print_pass: prints the 'PASS:' prefix; the caller appends the case name and
// ends the display row
//     clobbers: R13
print_pass:
    LDI 80          // 'P'
    CLL disp_putc
    LDI 65          // 'A'
    CLL disp_putc
    LDI 83          // 'S'
    CLL disp_putc
    LDI 83          // 'S'
    CLL disp_putc
    LDI 58          // ':'
    CLL disp_putc
    RET

// print_fail: prints the 'FAIL:' prefix; the caller appends the case name and
// ends the display row
//     clobbers: R13
print_fail:
    LDI 70          // 'F'
    CLL disp_putc
    LDI 65          // 'A'
    CLL disp_putc
    LDI 73          // 'I'
    CLL disp_putc
    LDI 76          // 'L'
    CLL disp_putc
    LDI 58          // ':'
    CLL disp_putc
    RET
