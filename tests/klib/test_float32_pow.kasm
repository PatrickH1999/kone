    CLL disp_putc
    LDI 119         // 'w'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 114         // 'r'
    CLL disp_putc
    LDI 111         // 'o'
    CLL disp_putc
    LDI 111         // 'o'
    CLL disp_putc
    LDI 116         // 't'
    CLL disp_putc
