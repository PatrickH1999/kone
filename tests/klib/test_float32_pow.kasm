    LDI 0x80
    STR 2
    LDI 0x40
    STR 3
    LDI 0x00
    STR 4
    LDI 0x00
    STR 5
    LDI 0x20
    STR 6
    LDI 0x40
    STR 7
    CLL float32_pow
    PSH             // 0 unless flagged as undefined
    LDI 0x00
    STR 4
    LDI 0x00
    STR 5
    LDI 0x00
    STR 6
    LDI 0x42
    STR 7
    CLL check
    STR 12
    POP
    ORR 12
    JA0 main__frac_pass
    LDM 0x8040
    STR 15
    LDI 1
    ADD 15
    STM 0x8040      // one more failed case
