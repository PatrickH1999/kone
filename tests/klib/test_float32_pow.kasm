main__summary:
    LDM 0x8040
    STR 15
    JA0 main__all_pass
    LDI 48          // '0'
    ADD 15          // at most one digit, there are nine cases
    CLL disp_putc
    LDI 32          // ' '
    CLL disp_putc
    LDI 70          // 'F'
    CLL disp_putc
    LDI 65          // 'A'
    CLL disp_putc
    LDI 73          // 'I'
    CLL disp_putc
    LDI 76          // 'L'
    CLL disp_putc
    LDI 69          // 'E'
    CLL disp_putc
    LDI 68          // 'D'
    CLL disp_putc
    JMP main__halt

main__all_pass:
    LDI 65          // 'A'
    CLL disp_putc
    LDI 76          // 'L'
    CLL disp_putc
    LDI 76          // 'L'
    CLL disp_putc
    LDI 32          // ' '
    CLL disp_putc
    LDI 80          // 'P'
    CLL disp_putc
    LDI 65          // 'A'
    CLL disp_putc
    LDI 83          // 'S'
    CLL disp_putc
    LDI 83          // 'S'
    CLL disp_putc

main__halt:
    JMP main__halt

// check: tells whether the result in R8 - R11 is within 4 units in the last
// place of the expected value in R4 - R7, by the distance of the two bit
// patterns; a sign that differs puts them far apart
//     out:      accumulator = 0 if the two are close
//     clobbers: R0 - R3, R8 - R13
check:
    LDR 8
    STR 0
    LDR 9
    STR 1
    LDR 10
    STR 2
    LDR 11
    STR 3
    CLL int32_sub   // R8 - R11 = C - E
    LDI 0x80
    STR 12
    LDR 11
    AND 12
    JA0 check__abs
    LDR 0
    STR 8
    LDR 1
    STR 9
    LDR 2
    STR 10
    LDR 3
    STR 11
    LDR 4
    STR 0
    LDR 5
    STR 1
    LDR 6
    STR 2
    LDR 7
    STR 3
    LDR 8
    STR 4
    LDR 9
    STR 5
    LDR 10
    STR 6
    LDR 11
    STR 7
    CLL int32_sub   // R8 - R11 = E - C

check__abs:
    LDR 11
    ORR 10
    ORR 9
    JA1 check__far
    LDI 251         // 256 - 5; carry set only for 5 and more
    ADD 8
    JC1 check__far
    LDI 0
    RET

check__far:
    LDI 1
    RET

// print_pass: prints the 'PASS:' prefix; the caller appends the case
// name and ends the display row
//     clobbers: R13
print_pass:
    LDI 80          // 'P'
    CLL disp_putc
    LDI 65          // 'A'
    CLL disp_putc
    LDI 83          // 'S'
    CLL disp_putc
    LDI 83          // 'S'
    CLL disp_putc
    LDI 58          // ':'
    CLL disp_putc
    RET

// print_fail: prints the 'FAIL:' prefix; the caller appends the case name
// and ends the display row
//     clobbers: R13
print_fail:
    LDI 70          // 'F'
    CLL disp_putc
    LDI 65          // 'A'
    CLL disp_putc
    LDI 73          // 'I'
    CLL disp_putc
    LDI 76          // 'L'
    CLL disp_putc
    LDI 58          // ':'
    CLL disp_putc
    RET
