    CLL disp_putc
    LDI 117         // 'u'
    CLL disp_putc
    LDI 98          // 'b'
    CLL disp_putc
    LDI 101         // 'e'
    CLL disp_putc
    CLL disp_nl

    // frac: 4 ** 2.5 = 32
    LDI 0x00
