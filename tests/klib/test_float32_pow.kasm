// test_float32_pow: checks klib's float32_pow against known results,
// each within 4 units in the last place:
//     40000000 ** 3F000000 = 3FB504F3     (2 ** 0.5 = 1.41421)
//     40800000 ** 3F000000 = 40000000     (4 ** 0.5 = 2)
//     41000000 ** 3EAA7EFA = 3FFFD297     (8 ** 0.333 = 1.99861)
//     40800000 ** 40200000 = 42000000     (4 ** 2.5 = 32)
//     C0000000 ** 40400000 = C1000000     (-2 ** 3 = -8)
//     40A00000 ** 00000000 = 3F800000     (5 ** 0 = 1)
//     40000000 ** BF800000 = 3F000000     (2 ** -1 = 0.5)
//     C1000000 ** 3F000000 = undefined    (-8 ** 0.5, undefined)
//     00000000 ** BF800000 = undefined    (0 ** -1, undefined)
//
// The failure count lives at 0x8040, as float32_pow clobbers R0 - R15.
// An undefined case passes when the routine flags it.

    JMP main

.include "../../klib/io/disp.kasm"
.include "../../klib/math/int32.kasm"
.include "../../klib/math/float32.kasm"

main:
    LDI 0
    STM 0x8040      // number of failed cases

    // sqrt: 2 ** 0.5 = 1.41421
    LDI 0x00
    STR 0
    LDI 0x00
    STR 1
    LDI 0x00
    STR 2
    LDI 0x40
    STR 3
    LDI 0x00
    STR 4
    LDI 0x00
    STR 5
    LDI 0x00
    STR 6
    LDI 0x3F
    STR 7
    CLL float32_pow
    PSH             // 0 unless flagged as undefined
    LDI 0xF3
    STR 4
    LDI 0x04
    STR 5
    LDI 0xB5
    STR 6
    LDI 0x3F
    STR 7
    CLL check
    STR 12
    POP
    ORR 12
    JA0 main__sqrt_pass
    LDM 0x8040
    STR 15
    LDI 1
    ADD 15
    STM 0x8040      // one more failed case
    CLL print_fail
    JMP main__sqrt_name
main__sqrt_pass:
    CLL print_pass
main__sqrt_name:
    LDI 102         // 'f'
    CLL disp_putc
    LDI 108         // 'l'
    CLL disp_putc
    LDI 111         // 'o'
    CLL disp_putc
    LDI 97          // 'a'
    CLL disp_putc
    LDI 116         // 't'
    CLL disp_putc
    LDI 51          // '3'
    CLL disp_putc
    LDI 50          // '2'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 112         // 'p'
    CLL disp_putc
    LDI 111         // 'o'
    CLL disp_putc
    LDI 119         // 'w'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 115         // 's'
    CLL disp_putc
    LDI 113         // 'q'
    CLL disp_putc
    LDI 114         // 'r'
    CLL disp_putc
    LDI 116         // 't'
    CLL disp_putc
    CLL disp_nl

    // root: 4 ** 0.5 = 2
    LDI 0x00
    STR 0
    LDI 0x00
    STR 1
    LDI 0x80
    STR 2
    LDI 0x40
    STR 3
    LDI 0x00
    STR 4
    LDI 0x00
    STR 5
    LDI 0x00
    STR 6
    LDI 0x3F
    STR 7
    CLL float32_pow
    PSH             // 0 unless flagged as undefined
    LDI 0x00
    STR 4
    LDI 0x00
    STR 5
    LDI 0x00
    STR 6
    LDI 0x40
    STR 7
    CLL check
    STR 12
    POP
    ORR 12
    JA0 main__root_pass
    LDM 0x8040
    STR 15
    LDI 1
    ADD 15
    STM 0x8040      // one more failed case
    CLL print_fail
    JMP main__root_name
main__root_pass:
    CLL print_pass
main__root_name:
    LDI 102         // 'f'
    CLL disp_putc
    LDI 108         // 'l'
    CLL disp_putc
    LDI 111         // 'o'
    CLL disp_putc
    LDI 97          // 'a'
    CLL disp_putc
    LDI 116         // 't'
    CLL disp_putc
    LDI 51          // '3'
    CLL disp_putc
    LDI 50          // '2'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
