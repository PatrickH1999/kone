// test_float32_mod: checks klib's float32_mod against known results:
//     40E00000 % 40400000 = 3F800000    (7 % 3 = 1)
//     C0E00000 % 40400000 = BF800000    (-7 % 3 = -1)
//     40F00000 % 40000000 = 3FC00000    (7.5 % 2 = 1.5)
//     40C00000 % 40400000 = 00000000    (6 % 3 = 0)
//     40000000 % 40A00000 = 40000000    (2 % 5 = 2)
//
// The failure count lives at 0x8040, as float32_mod clobbers R0 - R15.

    JMP main

.include "../../klib/io/disp.kasm"
.include "../../klib/math/float32.kasm"

main:
    LDI 0
    STM 0x8040      // number of failed cases

    // plain: 40E00000 % 40400000 = 3F800000    (7 % 3 = 1)
    LDI 0x00
    STR 0
    LDI 0x00
    STR 1
    LDI 0xE0
    STR 2
    LDI 0x40
    STR 3
    LDI 0x00
    STR 4
    LDI 0x00
    STR 5
    LDI 0x40
    STR 6
    LDI 0x40
    STR 7
    CLL float32_mod
    LDI 0x00
    STR 4
    LDI 0x00
    STR 5
    LDI 0x80
    STR 6
    LDI 0x3F
    STR 7
    CLL check
    JA0 main__mod_plain_pass
    LDM 0x8040
    STR 15
    LDI 1
    ADD 15
    STM 0x8040      // one more failed case
    CLL print_fail
    JMP main__mod_plain_name
main__mod_plain_pass:
    CLL print_pass
main__mod_plain_name:
    LDI 102         // 'f'
    CLL disp_putc
    LDI 108         // 'l'
    CLL disp_putc
    LDI 111         // 'o'
    CLL disp_putc
    LDI 97          // 'a'
    CLL disp_putc
    LDI 116         // 't'
    CLL disp_putc
    LDI 51          // '3'
    CLL disp_putc
    LDI 50          // '2'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 109         // 'm'
    CLL disp_putc
    LDI 111         // 'o'
    CLL disp_putc
    LDI 100         // 'd'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 112         // 'p'
    CLL disp_putc
    LDI 108         // 'l'
    CLL disp_putc
    LDI 97          // 'a'
    CLL disp_putc
    LDI 105         // 'i'
    CLL disp_putc
    LDI 110         // 'n'
    CLL disp_putc
    CLL disp_nl

    // neg: C0E00000 % 40400000 = BF800000    (-7 % 3 = -1)
    LDI 0x00
    STR 0
    LDI 0x00
    STR 1
    LDI 0xE0
    STR 2
    LDI 0xC0
    STR 3
    LDI 0x00
    STR 4
    LDI 0x00
    STR 5
    LDI 0x40
    STR 6
    LDI 0x40
    STR 7
    CLL float32_mod
    LDI 0x00
    STR 4
    LDI 0x00
    STR 5
    LDI 0x80
    STR 6
    LDI 0xBF
    STR 7
    CLL check
    JA0 main__mod_neg_pass
    LDM 0x8040
    STR 15
    LDI 1
    ADD 15
    STM 0x8040      // one more failed case
    CLL print_fail
    JMP main__mod_neg_name
main__mod_neg_pass:
    CLL print_pass
main__mod_neg_name:
    LDI 102         // 'f'
    CLL disp_putc
    LDI 108         // 'l'
    CLL disp_putc
    LDI 111         // 'o'
    CLL disp_putc
    LDI 97          // 'a'
    CLL disp_putc
    LDI 116         // 't'
    CLL disp_putc
    LDI 51          // '3'
    CLL disp_putc
    LDI 50          // '2'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 109         // 'm'
    CLL disp_putc
    LDI 111         // 'o'
    CLL disp_putc
    LDI 100         // 'd'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 110         // 'n'
    CLL disp_putc
    LDI 101         // 'e'
    CLL disp_putc
    LDI 103         // 'g'
    CLL disp_putc
    CLL disp_nl

    // frac: 40F00000 % 40000000 = 3FC00000    (7.5 % 2 = 1.5)
    LDI 0x00
    STR 0
    LDI 0x00
    STR 1
    LDI 0xF0
    STR 2
    LDI 0x40
    STR 3
    LDI 0x00
    STR 4
    LDI 0x00
    STR 5
    LDI 0x00
    STR 6
    LDI 0x40
    STR 7
    CLL float32_mod
    LDI 0x00
    STR 4
    LDI 0x00
    STR 5
    LDI 0xC0
    STR 6
    LDI 0x3F
    STR 7
    CLL check
    JA0 main__mod_frac_pass
    LDM 0x8040
    STR 15
    LDI 1
    ADD 15
    STM 0x8040      // one more failed case
    CLL print_fail
    JMP main__mod_frac_name
main__mod_frac_pass:
    CLL print_pass
main__mod_frac_name:
    LDI 102         // 'f'
    CLL disp_putc
    LDI 108         // 'l'
    CLL disp_putc
    LDI 111         // 'o'
    CLL disp_putc
    LDI 97          // 'a'
    CLL disp_putc
    LDI 116         // 't'
    CLL disp_putc
    LDI 51          // '3'
    CLL disp_putc
    LDI 50          // '2'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 109         // 'm'
    CLL disp_putc
    LDI 111         // 'o'
    CLL disp_putc
    LDI 100         // 'd'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 102         // 'f'
    CLL disp_putc
    LDI 114         // 'r'
    CLL disp_putc
    LDI 97          // 'a'
    CLL disp_putc
    LDI 99          // 'c'
    CLL disp_putc
    CLL disp_nl

    // exact: 40C00000 % 40400000 = 00000000    (6 % 3 = 0)
    LDI 0x00
    STR 0
    LDI 0x00
    STR 1
    LDI 0xC0
    STR 2
    LDI 0x40
    STR 3
    LDI 0x00
    STR 4
    LDI 0x00
    STR 5
    LDI 0x40
    STR 6
    LDI 0x40
    STR 7
    CLL float32_mod
    LDI 0x00
    STR 4
    LDI 0x00
    STR 5
    LDI 0x00
    STR 6
    LDI 0x00
    STR 7
    CLL check
    JA0 main__mod_exact_pass
    LDM 0x8040
    STR 15
    LDI 1
    ADD 15
    STM 0x8040      // one more failed case
    CLL print_fail
    JMP main__mod_exact_name
main__mod_exact_pass:
    CLL print_pass
main__mod_exact_name:
    LDI 102         // 'f'
    CLL disp_putc
    LDI 108         // 'l'
    CLL disp_putc
    LDI 111         // 'o'
    CLL disp_putc
    LDI 97          // 'a'
    CLL disp_putc
    LDI 116         // 't'
    CLL disp_putc
    LDI 51          // '3'
    CLL disp_putc
    LDI 50          // '2'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 109         // 'm'
    CLL disp_putc
    LDI 111         // 'o'
    CLL disp_putc
    LDI 100         // 'd'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 101         // 'e'
    CLL disp_putc
    LDI 120         // 'x'
    CLL disp_putc
    LDI 97          // 'a'
    CLL disp_putc
    LDI 99          // 'c'
    CLL disp_putc
    LDI 116         // 't'
    CLL disp_putc
    CLL disp_nl

    // small: 40000000 % 40A00000 = 40000000    (2 % 5 = 2)
    LDI 0x00
    STR 0
    LDI 0x00
    STR 1
    LDI 0x00
    STR 2
    LDI 0x40
    STR 3
    LDI 0x00
    STR 4
    LDI 0x00
    STR 5
    LDI 0xA0
    STR 6
    LDI 0x40
    STR 7
    CLL float32_mod
    LDI 0x00
    STR 4
    LDI 0x00
    STR 5
    LDI 0x00
    STR 6
    LDI 0x40
    STR 7
    CLL check
    JA0 main__mod_small_pass
    LDM 0x8040
    STR 15
    LDI 1
    ADD 15
    STM 0x8040      // one more failed case
    CLL print_fail
    JMP main__mod_small_name
main__mod_small_pass:
    CLL print_pass
main__mod_small_name:
    LDI 102         // 'f'
    CLL disp_putc
    LDI 108         // 'l'
    CLL disp_putc
    LDI 111         // 'o'
    CLL disp_putc
    LDI 97          // 'a'
    CLL disp_putc
    LDI 116         // 't'
    CLL disp_putc
    LDI 51          // '3'
    CLL disp_putc
    LDI 50          // '2'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 109         // 'm'
    CLL disp_putc
    LDI 111         // 'o'
    CLL disp_putc
    LDI 100         // 'd'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 115         // 's'
    CLL disp_putc
    LDI 109         // 'm'
    CLL disp_putc
    LDI 97          // 'a'
    CLL disp_putc
    LDI 108         // 'l'
    CLL disp_putc
    LDI 108         // 'l'
    CLL disp_putc
    CLL disp_nl

main__summary:
    LDM 0x8040
    STR 15
    JA0 main__all_pass
    LDI 48          // '0'
    ADD 15          // at most one digit, there are five cases
    CLL disp_putc
    LDI 32          // ' '
    CLL disp_putc
    LDI 70          // 'F'
    CLL disp_putc
    LDI 65          // 'A'
    CLL disp_putc
    LDI 73          // 'I'
    CLL disp_putc
    LDI 76          // 'L'
    CLL disp_putc
    LDI 69          // 'E'
    CLL disp_putc
    LDI 68          // 'D'
    CLL disp_putc
    CLL disp_nl
    JMP main__halt

main__all_pass:
    LDI 65          // 'A'
    CLL disp_putc
    LDI 76          // 'L'
    CLL disp_putc
    LDI 76          // 'L'
    CLL disp_putc
    LDI 32          // ' '
    CLL disp_putc
    LDI 80          // 'P'
    CLL disp_putc
    LDI 65          // 'A'
    CLL disp_putc
    LDI 83          // 'S'
    CLL disp_putc
    LDI 83          // 'S'
    CLL disp_putc
    CLL disp_nl

main__halt:
    JMP main__halt

// check: compares the result in R8 - R11 against the expected value in
// R4 - R7
//     out:      accumulator = 0 if the two are equal
//     clobbers: R12
check:
    LDR 8
    XOR 4
    STR 12
    LDR 9
    XOR 5
    ORR 12
    STR 12
    LDR 10
    XOR 6
    ORR 12
    STR 12
    LDR 11
    XOR 7
    ORR 12
    RET

// print_pass: prints the 'PASS:' prefix; the caller appends the case
// name and ends the display row
//     clobbers: R13
print_pass:
    LDI 80          // 'P'
    CLL disp_putc
    LDI 65          // 'A'
    CLL disp_putc
    LDI 83          // 'S'
    CLL disp_putc
    LDI 83          // 'S'
    CLL disp_putc
    LDI 58          // ':'
    CLL disp_putc
    RET

// print_fail: prints the 'FAIL:' prefix; the caller appends the case name
// and ends the display row
//     clobbers: R13
print_fail:
    LDI 70          // 'F'
    CLL disp_putc
    LDI 65          // 'A'
    CLL disp_putc
    LDI 73          // 'I'
    CLL disp_putc
    LDI 76          // 'L'
    CLL disp_putc
    LDI 58          // ':'
    CLL disp_putc
    RET
