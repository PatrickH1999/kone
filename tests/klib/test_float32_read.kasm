
// test_float32_read: checks klib's float32_read against the keystrokes in
// tests/klib/test_float32_read.in, which the harness pipes into the vm; every
// case prints 'PASS:<case>' or 'FAIL:<case>' on its own display row, followed
// by a summary row ('ALL PASS' or '<n> FAILED'):
//     '1.5 '   -> 3FC00000
//     '-2.5 '  -> C0200000
//     '1.5e2 ' -> 43160000 (150)
//     '0 '     -> 00000000
//
// The echo of every keystroke is what the first display rows are made of. The
// expected value can only be loaded after the call, as float32_read clobbers
// R0 - R15; the failure count lives at 0x8040 for the same reason.

    JMP main

.include "../../klib/io/disp.kasm"
.include "../../klib/math/int32.kasm"
.include "../../klib/math/float32.kasm"
.include "../../klib/io/float32_read.kasm"

main:
    LDI 0
    STM 0x8040      // number of failed cases

    CLL float32_read
    LDI 0x00
    STR 4
    LDI 0x00
    STR 5
    LDI 0xC0
    STR 6
    LDI 0x3F
    STR 7           // 1.5
    CLL check_a
    JA0 main__float32_read_plain_pass
    LDM 0x8040
    STR 12
    LDI 1
    ADD 12
    STM 0x8040      // one more failed case
    CLL print_fail
    JMP main__float32_read_plain_name
main__float32_read_plain_pass:
    CLL print_pass
main__float32_read_plain_name:
    LDI 102         // 'f'
    CLL disp_putc
    LDI 108         // 'l'
    CLL disp_putc
    LDI 111         // 'o'
    CLL disp_putc
    LDI 97          // 'a'
    CLL disp_putc
    LDI 116         // 't'
    CLL disp_putc
    LDI 51          // '3'
    CLL disp_putc
    LDI 50          // '2'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 114         // 'r'
    CLL disp_putc
    LDI 101         // 'e'
    CLL disp_putc
    LDI 97          // 'a'
    CLL disp_putc
    LDI 100         // 'd'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 112         // 'p'
    CLL disp_putc
    LDI 108         // 'l'
    CLL disp_putc
    LDI 97          // 'a'
    CLL disp_putc
    LDI 105         // 'i'
    CLL disp_putc
    LDI 110         // 'n'
    CLL disp_putc
    CLL disp_nl

    CLL float32_read
    LDI 0x00
    STR 4
    LDI 0x00
    STR 5
    LDI 0x20
    STR 6
    LDI 0xC0
    STR 7           // -2.5
    CLL check_a
    JA0 main__float32_read_neg_pass
    LDM 0x8040
    STR 12
    LDI 1
    ADD 12
    STM 0x8040      // one more failed case
    CLL print_fail
    JMP main__float32_read_neg_name
main__float32_read_neg_pass:
    CLL print_pass
main__float32_read_neg_name:
    LDI 102         // 'f'
    CLL disp_putc
    LDI 108         // 'l'
    CLL disp_putc
    LDI 111         // 'o'
    CLL disp_putc
    LDI 97          // 'a'
    CLL disp_putc
    LDI 116         // 't'
    CLL disp_putc
    LDI 51          // '3'
    CLL disp_putc
    LDI 50          // '2'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 114         // 'r'
    CLL disp_putc
    LDI 101         // 'e'
    CLL disp_putc
    LDI 97          // 'a'
    CLL disp_putc
    LDI 100         // 'd'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 110         // 'n'
    CLL disp_putc
    LDI 101         // 'e'
    CLL disp_putc
    LDI 103         // 'g'
    CLL disp_putc
    CLL disp_nl

    CLL float32_read
    LDI 0x00
    STR 4
    LDI 0x00
    STR 5
    LDI 0x16
    STR 6
    LDI 0x43
    STR 7           // 1.5e2
    CLL check_a
    JA0 main__float32_read_exp_pass
    LDM 0x8040
    STR 12
    LDI 1
    ADD 12
    STM 0x8040      // one more failed case
    CLL print_fail
    JMP main__float32_read_exp_name
main__float32_read_exp_pass:
    CLL print_pass
main__float32_read_exp_name:
    LDI 102         // 'f'
    CLL disp_putc
    LDI 108         // 'l'
    CLL disp_putc
    LDI 111         // 'o'
    CLL disp_putc
    LDI 97          // 'a'
    CLL disp_putc
    LDI 116         // 't'
    CLL disp_putc
    LDI 51          // '3'
    CLL disp_putc
    LDI 50          // '2'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 114         // 'r'
    CLL disp_putc
    LDI 101         // 'e'
    CLL disp_putc
    LDI 97          // 'a'
    CLL disp_putc
    LDI 100         // 'd'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 101         // 'e'
    CLL disp_putc
    LDI 120         // 'x'
    CLL disp_putc
    LDI 112         // 'p'
    CLL disp_putc
    CLL disp_nl

    CLL float32_read
    LDI 0x00
    STR 4
    LDI 0x00
    STR 5
    LDI 0x00
    STR 6
    LDI 0x00
    STR 7           // 0
    CLL check_a
    JA0 main__float32_read_zero_pass
    LDM 0x8040
    STR 12
    LDI 1
    ADD 12
    STM 0x8040      // one more failed case
    CLL print_fail
    JMP main__float32_read_zero_name
main__float32_read_zero_pass:
    CLL print_pass
main__float32_read_zero_name:
    LDI 102         // 'f'
    CLL disp_putc
    LDI 108         // 'l'
    CLL disp_putc
    LDI 111         // 'o'
    CLL disp_putc
    LDI 97          // 'a'
    CLL disp_putc
    LDI 116         // 't'
    CLL disp_putc
    LDI 51          // '3'
    CLL disp_putc
    LDI 50          // '2'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 114         // 'r'
    CLL disp_putc
    LDI 101         // 'e'
    CLL disp_putc
    LDI 97          // 'a'
    CLL disp_putc
    LDI 100         // 'd'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 122         // 'z'
    CLL disp_putc
    LDI 101         // 'e'
    CLL disp_putc
    LDI 114         // 'r'
    CLL disp_putc
    LDI 111         // 'o'
    CLL disp_putc
    CLL disp_nl

main__summary:
    LDM 0x8040
    JA0 main__all_pass
    STR 12
    LDI 48          // '0'
    ADD 12          // at most one digit, there are fewer than ten cases
    CLL disp_putc
    LDI 32          // ' '
    CLL disp_putc
    LDI 70          // 'F'
    CLL disp_putc
    LDI 65          // 'A'
    CLL disp_putc
    LDI 73          // 'I'
    CLL disp_putc
    LDI 76          // 'L'
    CLL disp_putc
    LDI 69          // 'E'
    CLL disp_putc
    LDI 68          // 'D'
    CLL disp_putc
    CLL disp_nl
    JMP main__halt

main__all_pass:
    LDI 65          // 'A'
    CLL disp_putc
    LDI 76          // 'L'
    CLL disp_putc
    LDI 76          // 'L'
    CLL disp_putc
    LDI 32          // ' '
    CLL disp_putc
    LDI 80          // 'P'
    CLL disp_putc
    LDI 65          // 'A'
    CLL disp_putc
    LDI 83          // 'S'
    CLL disp_putc
    LDI 83          // 'S'
    CLL disp_putc
    CLL disp_nl

main__halt:
    JMP main__halt

// check_a: compares the value in R0 - R3 against the expected value in R4 - R7
//     out:      accumulator = 0 if the two are equal
//     clobbers: R12
check_a:
    LDR 0
    XOR 4
    STR 12
    LDR 1
    XOR 5
    ORR 12
    STR 12
    LDR 2
    XOR 6
    ORR 12
    STR 12
    LDR 3
    XOR 7
    ORR 12
    RET

// print_pass: prints the 'PASS:' prefix; the caller appends the case name and
// ends the display row
//     clobbers: R13
print_pass:
    LDI 80          // 'P'
    CLL disp_putc
    LDI 65          // 'A'
    CLL disp_putc
    LDI 83          // 'S'
    CLL disp_putc
    LDI 83          // 'S'
    CLL disp_putc
    LDI 58          // ':'
    CLL disp_putc
    RET

// print_fail: prints the 'FAIL:' prefix; the caller appends the case name and
// ends the display row
//     clobbers: R13
print_fail:
    LDI 70          // 'F'
    CLL disp_putc
    LDI 65          // 'A'
    CLL disp_putc
    LDI 73          // 'I'
    CLL disp_putc
    LDI 76          // 'L'
    CLL disp_putc
    LDI 58          // ':'
    CLL disp_putc
    RET
