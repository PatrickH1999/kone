// test_int32_pow: checks klib's int32_pow against known results:
//     00000002 ** 10  = 00000400
//     00000007 ** 0   = 00000001
//     00000003 ** 21  = 6F7C52B3    (wrapped)
//     FFFFFFFF ** 257 = FFFFFFFF    (-1 ** 257, a count that borrows)
//

    JMP main

.include "../../klib/io/disp.kasm"
.include "../../klib/math/int32.kasm"

main:
    LDI 0
    STR 15          // number of failed cases

    // pow_two: 00000002 ** 10 = 00000400
    LDI 0x02
    STR 0
    LDI 0x00
    STR 1
    LDI 0x00
    STR 2
    LDI 0x00
    STR 3
    LDI 0x0A
    STR 4
    LDI 0x00
    STR 5
    LDI 0x00
    STR 6
    LDI 0x00
    STR 7
    CLL int32_pow
    LDI 0x00
    STR 4
    LDI 0x04
    STR 5
    LDI 0x00
    STR 6
    LDI 0x00
    STR 7
    CLL check
    JA0 main__pow_two_pass
    LDI 1
    ADD 15
    STR 15          // one more failed case
    CLL print_fail
    JMP main__pow_two_name
main__pow_two_pass:
    CLL print_pass
main__pow_two_name:
    LDI 105         // 'i'
    CLL disp_putc
    LDI 110         // 'n'
    CLL disp_putc
    LDI 116         // 't'
    CLL disp_putc
    LDI 51          // '3'
    CLL disp_putc
    LDI 50          // '2'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 112         // 'p'
    CLL disp_putc
    LDI 111         // 'o'
    CLL disp_putc
    LDI 119         // 'w'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 116         // 't'
    CLL disp_putc
    LDI 119         // 'w'
    CLL disp_putc
    LDI 111         // 'o'
    CLL disp_putc
    CLL disp_nl

    // pow_zero: 00000007 ** 0 = 00000001
    LDI 0x07
    STR 0
    LDI 0x00
    STR 1
    LDI 0x00
    STR 2
    LDI 0x00
    STR 3
    LDI 0x00
    STR 4
    LDI 0x00
    STR 5
    LDI 0x00
    STR 6
    LDI 0x00
    STR 7
    CLL int32_pow
    LDI 0x01
    STR 4
    LDI 0x00
    STR 5
    LDI 0x00
    STR 6
    LDI 0x00
    STR 7
    CLL check
    JA0 main__pow_zero_pass
    LDI 1
    ADD 15
    STR 15          // one more failed case
    CLL print_fail
    JMP main__pow_zero_name
main__pow_zero_pass:
    CLL print_pass
main__pow_zero_name:
    LDI 105         // 'i'
    CLL disp_putc
    LDI 110         // 'n'
    CLL disp_putc
    LDI 116         // 't'
    CLL disp_putc
    LDI 51          // '3'
    CLL disp_putc
    LDI 50          // '2'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 112         // 'p'
    CLL disp_putc
    LDI 111         // 'o'
    CLL disp_putc
    LDI 119         // 'w'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 122         // 'z'
    CLL disp_putc
    LDI 101         // 'e'
    CLL disp_putc
    LDI 114         // 'r'
    CLL disp_putc
    LDI 111         // 'o'
    CLL disp_putc
    CLL disp_nl

    // pow_wrap: 00000003 ** 21 = 6F7C52B3
    LDI 0x03
    STR 0
    LDI 0x00
    STR 1
    LDI 0x00
    STR 2
    LDI 0x00
    STR 3
    LDI 0x15
    STR 4
    LDI 0x00
    STR 5
    LDI 0x00
    STR 6
    LDI 0x00
    STR 7
    CLL int32_pow
    LDI 0xB3
    STR 4
    LDI 0x52
    STR 5
    LDI 0x7C
    STR 6
    LDI 0x6F
    STR 7
    CLL check
    JA0 main__pow_wrap_pass
    LDI 1
    ADD 15
    STR 15          // one more failed case
    CLL print_fail
    JMP main__pow_wrap_name
main__pow_wrap_pass:
    CLL print_pass
main__pow_wrap_name:
    LDI 105         // 'i'
    CLL disp_putc
    LDI 110         // 'n'
    CLL disp_putc
    LDI 116         // 't'
    CLL disp_putc
    LDI 51          // '3'
    CLL disp_putc
    LDI 50          // '2'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 112         // 'p'
    CLL disp_putc
    LDI 111         // 'o'
    CLL disp_putc
    LDI 119         // 'w'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 119         // 'w'
    CLL disp_putc
    LDI 114         // 'r'
    CLL disp_putc
    LDI 97          // 'a'
    CLL disp_putc
    LDI 112         // 'p'
    CLL disp_putc
    CLL disp_nl

    // pow_borrow: FFFFFFFF ** 257 = FFFFFFFF
    LDI 0xFF
    STR 0
    LDI 0xFF
    STR 1
    LDI 0xFF
    STR 2
    LDI 0xFF
    STR 3
    LDI 0x01
    STR 4
    LDI 0x01
    STR 5
    LDI 0x00
    STR 6
    LDI 0x00
    STR 7
    CLL int32_pow
    LDI 0xFF
    STR 4
    LDI 0xFF
    STR 5
    LDI 0xFF
    STR 6
    LDI 0xFF
    STR 7
    CLL check
    JA0 main__pow_borrow_pass
    LDI 1
    ADD 15
    STR 15          // one more failed case
    CLL print_fail
    JMP main__pow_borrow_name
main__pow_borrow_pass:
    CLL print_pass
main__pow_borrow_name:
    LDI 105         // 'i'
    CLL disp_putc
    LDI 110         // 'n'
    CLL disp_putc
    LDI 116         // 't'
    CLL disp_putc
    LDI 51          // '3'
    CLL disp_putc
    LDI 50          // '2'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 112         // 'p'
    CLL disp_putc
    LDI 111         // 'o'
    CLL disp_putc
    LDI 119         // 'w'
    CLL disp_putc
    LDI 95          // '_'
    CLL disp_putc
    LDI 98          // 'b'
    CLL disp_putc
    LDI 111         // 'o'
    CLL disp_putc
    LDI 114         // 'r'
    CLL disp_putc
    LDI 114         // 'r'
    CLL disp_putc
    LDI 111         // 'o'
    CLL disp_putc
    LDI 119         // 'w'
    CLL disp_putc
    CLL disp_nl

main__summary:
    LDR 15
    JA0 main__all_pass
    LDI 48          // '0'
    ADD 15          // at most one digit, there are four cases
    CLL disp_putc
    LDI 32          // ' '
    CLL disp_putc
    LDI 70          // 'F'
    CLL disp_putc
    LDI 65          // 'A'
    CLL disp_putc
    LDI 73          // 'I'
    CLL disp_putc
    LDI 76          // 'L'
    CLL disp_putc
    LDI 69          // 'E'
    CLL disp_putc
    LDI 68          // 'D'
    CLL disp_putc
    JMP main__halt

main__all_pass:
    LDI 65          // 'A'
    CLL disp_putc
    LDI 76          // 'L'
    CLL disp_putc
    LDI 76          // 'L'
    CLL disp_putc
    LDI 32          // ' '
    CLL disp_putc
    LDI 80          // 'P'
    CLL disp_putc
    LDI 65          // 'A'
    CLL disp_putc
    LDI 83          // 'S'
    CLL disp_putc
    LDI 83          // 'S'
    CLL disp_putc

main__halt:
    JMP main__halt

// check: compares the result in R8 - R11 against the expected value in
// R4 - R7
//     out:      accumulator = 0 if the two are equal
//     clobbers: R12
check:
    LDR 8
    XOR 4
    STR 12
    LDR 9
    XOR 5
    ORR 12
    STR 12
    LDR 10
    XOR 6
    ORR 12
    STR 12
    LDR 11
    XOR 7
    ORR 12
    RET

// print_pass: prints the 'PASS:' prefix; the caller appends the case
// name and ends the display row
//     clobbers: R13
print_pass:
    LDI 80          // 'P'
    CLL disp_putc
    LDI 65          // 'A'
    CLL disp_putc
    LDI 83          // 'S'
    CLL disp_putc
    LDI 83          // 'S'
    CLL disp_putc
    LDI 58          // ':'
    CLL disp_putc
    RET

// print_fail: prints the 'FAIL:' prefix; the caller appends the case name
// and ends the display row
//     clobbers: R13
print_fail:
    LDI 70          // 'F'
    CLL disp_putc
    LDI 65          // 'A'
    CLL disp_putc
    LDI 73          // 'I'
    CLL disp_putc
    LDI 76          // 'L'
    CLL disp_putc
    LDI 58          // ':'
    CLL disp_putc
    RET
