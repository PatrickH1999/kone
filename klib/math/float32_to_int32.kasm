// float32_to_int32: C = A as a 32 bit signed integer, truncated towards zero
//     in:       A -> R0 - R3, byte order LSB -> MSB
//     out:      C -> R8 - R11
//     clobbers: R0 - R7, R12 - R15
//
// The mantissa is shifted by the unbiased exponent and the sign is applied
// afterwards. A magnitude below 1 yields 0, and one that does not fit into a
// signed 32 bit integer saturates to 2147483647 or -2147483648 rather than
// wrapping, which is also what an operand with exponent 255 (infinity, NaN)
// ends up as.
float32_to_int32:
    LDI 0
    STR 4
    STR 5
    STR 6
    STR 7
    CLL float32_unpack

    LDR 3
    JA0 float32_to_int32__zero

    LDI 129         // - 127, the exponent bias
    ADD 3
    STR 13
    JC0 float32_to_int32__zero

    LDI 225         // - 31, the first exponent that no longer fits
    ADD 13
    JC1 float32_to_int32__sat

    LDI 0
    STR 3
    LDI 233         // - 23, the number of mantissa bits below the leading one
    ADD 13
    STR 14
    JC1 float32_to_int32__left

    LDR 14
    NOT
    STR 14
    LDI 1
    ADD 14
    STR 14

float32_to_int32__right:
    LDR 14
    JA0 float32_to_int32__sign
    LDI 255
    ADD 14
    STR 14

    LDI 0x80
    STR 15
    LDR 0
    BSR
    STR 0
    LDR 1
    BRR
    AND 15
    ORR 0
    STR 0
    LDR 1
    BSR
    STR 1
    LDR 2
    BRR
    AND 15
    ORR 1
    STR 1
    LDR 2
    BSR
    STR 2
    LDR 3
    BRR
    AND 15
    ORR 2
    STR 2
    LDR 3
    BSR
    STR 3
    JMP float32_to_int32__right

float32_to_int32__left:
    LDR 14
    JA0 float32_to_int32__sign
    LDI 255
    ADD 14
    STR 14

    LDI 0x01
    STR 15
    LDR 3
    BSL
    STR 3
    LDR 2
    BRL
    AND 15
    ORR 3
    STR 3
    LDR 2
    BSL
    STR 2
    LDR 1
    BRL
    AND 15
    ORR 2
    STR 2
    LDR 1
    BSL
    STR 1
    LDR 0
    BRL
    AND 15
    ORR 1
    STR 1
    LDR 0
    BSL
    STR 0
    JMP float32_to_int32__left

float32_to_int32__sign:
    LDR 0
    STR 8
    LDR 1
    STR 9
    LDR 2
    STR 10
    LDR 3
    STR 11
    LDR 12
    JA0 float32_to_int32__done

    LDI 1
    STR 14
    LDR 8
    NOT
    ADD 14
    STR 8
    LDR 26
    STR 14
    LDR 9
    NOT
    ADD 14
    STR 9
    LDR 26
    STR 14
    LDR 10
    NOT
    ADD 14
    STR 10
    LDR 26
    STR 14
    LDR 11
    NOT
    ADD 14
    STR 11

float32_to_int32__done:
    RET

float32_to_int32__zero:
    LDI 0
    STR 8
    STR 9
    STR 10
    STR 11
    RET

float32_to_int32__sat:
    LDI 0xFF
    STR 8
    STR 9
    STR 10
    LDI 0x7F
    STR 11
    LDR 12
    JA0 float32_to_int32__done
    LDI 0x00
    STR 8
    STR 9
    STR 10
    LDI 0x80
    STR 11
    RET
