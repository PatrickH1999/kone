// int32_mul: C = A * B, 32 bit, byte order LSB -> MSB
//     in:       A -> R0 - R3, B -> R4 - R7
//     out:      C -> R8 - R11, the high 32 bit of the product are discarded
//     clobbers: R0 - R7, R12
int32_mul:
    LDI 0x00
    STR 8
    STR 9
    STR 10
    STR 11

int32_mul__loop:
    LDR 4
    ORR 5
    ORR 6
    ORR 7
    JA0 int32_mul__done

    LDI 0x01
    STR 12
    LDR 4
    AND 12
    JA0 int32_mul__shift

    LDR 8
    ADD 0
    STR 8
    LDR 26
    STR 12

    LDR 9
    ADD 12
    STR 9
    LDR 26
    STR 12
    LDR 9
    ADD 1
    STR 9
    LDR 26
    ADD 12
    STR 12

    LDR 10
    ADD 12
    STR 10
    LDR 26
    STR 12
    LDR 10
    ADD 2
    STR 10
    LDR 26
    ADD 12
    STR 12

    LDR 11
    ADD 12
    ADD 3
    STR 11

int32_mul__shift:
    LDI 0x01
    STR 12
    LDR 3
    BSL
    STR 3
    LDR 2
    BRL
    AND 12
    ORR 3
    STR 3
    LDR 2
    BSL
    STR 2
    LDR 1
    BRL
    AND 12
    ORR 2
    STR 2
    LDR 1
    BSL
    STR 1
    LDR 0
    BRL
    AND 12
    ORR 1
    STR 1
    LDR 0
    BSL
    STR 0

    LDI 0x80
    STR 12
    LDR 4
    BSR
    STR 4
    LDR 5
    BRR
    AND 12
    ORR 4
    STR 4
    LDR 5
    BSR
    STR 5
    LDR 6
    BRR
    AND 12
    ORR 5
    STR 5
    LDR 6
    BSR
    STR 6
    LDR 7
    BRR
    AND 12
    ORR 6
    STR 6
    LDR 7
    BSR
    STR 7

    JMP int32_mul__loop

int32_mul__done:
    RET
