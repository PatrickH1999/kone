// io: every display and keyboard routine of klib in one include; see the files
// in klib/io/ for their calling conventions. The readers and writers need
// klib/math.kasm alongside this file, which it does not pull in itself because
// includes are not idempotent (see README.md).

.include "io/disp.kasm"
.include "io/int32_write.kasm"
.include "io/int32_read.kasm"
.include "io/float32_write.kasm"
.include "io/float32_read.kasm"
