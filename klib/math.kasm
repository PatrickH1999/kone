// math: the 32 bit integer group and the IEEE 754 single precision group in
// one include; see the files in klib/math/ for their calling conventions. The
// two are independent, so a program needing only one is better off including
// klib/math/int32.kasm or klib/math/float32.kasm alone.

.include "math/int32.kasm"
.include "math/float32.kasm"
