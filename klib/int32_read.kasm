// int32_read: reads a decimal number from the keyboard (R16/R17) and echoes
// every typed char to the display; '.' and ',' are dropped, so numbers may be
// typed with thousands separators
//     in:       -
//     out:      A -> R0 - R3, byte order LSB -> MSB, two's complement,
//               R14 -> terminator char
//     clobbers: R12 - R15
//
// The magnitude is built up digit by digit as A = A * 10 + digit, using
// int32_mul and int32_add. A '-' typed before the first digit makes the
// number negative; anywhere else it ends the number like any other non-digit.
// A backspace (8 or 127, see README) drops the last digit again (A = A / 10
// via int32_div) and erases it from the display, down to the start of the
// number -- the prompt and the operator before it are never touched. A
// backspace with nothing left to erase ends the number like any char that does
// not fit, except that it is not echoed: it lands in R14 like every other
// terminator, so a caller that printed something before the call can take that
// back itself (see examples/calculator_int32.kasm).
//
// Reading stops at the first char that is neither a digit nor part of the
// editing above; that char is echoed as well and left in R14, so the caller
// can tell which key ended the number (kone maps ENTER to ' '). Echoing goes
// through 'disp_putc' and 'disp_bs' from klib/disp.kasm, which also documents
// the scratch memory this file uses.
int32_read:
    LDR 4
    PSH
    LDR 5
    PSH
    LDR 6
    PSH
    LDR 7
    PSH
    LDR 8
    PSH
    LDR 9
    PSH
    LDR 10
    PSH
    LDR 11
    PSH             // R4 - R11 are restored right before RET

    LDI 0
    STR 0
    STR 1
    STR 2
    STR 3
    STM 0x800A      // digits typed so far
    STM 0x800B      // 1 once a leading '-' was typed

int32_read__loop:
    LDR 16          // keyboard set-bit
    JA0 int32_read__loop
    LDR 17
    STR 14          // received char
    LDI 0
    STR 16          // clear the set-bit -> acknowledge the char

    LDR 14
    STR 13
    LDI 210         // 256 - 46 -> '.' is a separator, drop it
    ADD 13
    JA0 int32_read__loop
    LDI 212         // 256 - 44 -> ',' is a separator, drop it
    ADD 13
    JA0 int32_read__loop
    LDI 129         // 256 - 127 -> DEL, erase the last digit
    ADD 13
    JA0 int32_read__erase
    LDI 248         // 256 - 8 -> BS, erase the last digit
    ADD 13
    JA0 int32_read__erase

    LDI 211         // 256 - 45 -> '-'
    ADD 13
    JA1 int32_read__echo
    LDM 0x800A
    JA1 int32_read__echo    // a digit came first -> '-' ends the number
    LDM 0x800B
    JA1 int32_read__echo    // a second '-' -> it ends the number
    LDI 1
    STM 0x800B      // leading '-' -> the number is negative
    LDR 14
    CLL disp_putc
    JMP int32_read__loop

int32_read__echo:
    LDR 14
    CLL disp_putc

    LDR 14
    STR 13
    LDI 208         // 256 - 48; carry set only for chars >= '0'
    ADD 13
    JC0 int32_read__done
    STR 15          // R15 = char - '0'
    LDI 246         // 256 - 10; carry set only for chars > '9'
    ADD 15
    JC1 int32_read__done

    LDM 0x800A
    STR 13
    LDI 1
    ADD 13
    STM 0x800A      // one more digit typed

    LDI 10
    STR 4
    LDI 0
    STR 5
    STR 6
    STR 7
    CLL int32_mul   // R8 - R11 = A * 10
    LDR 8
    STR 0
    LDR 9
    STR 1
    LDR 10
    STR 2
    LDR 11
    STR 3

    LDR 15
    STR 4
    LDI 0
    STR 5
    STR 6
    STR 7
    CLL int32_add   // R8 - R11 = A * 10 + digit
    LDR 8
    STR 0
    LDR 9
    STR 1
    LDR 10
    STR 2
    LDR 11
    STR 3

    JMP int32_read__loop

int32_read__erase:
    LDM 0x800A
    JA0 int32_read__erase_sign
    STR 13
    LDI 255
    ADD 13
    STM 0x800A      // one digit less
    LDI 10
    STR 4
    LDI 0
    STR 5
    STR 6
    STR 7
    CLL int32_div   // R8 - R11 = A / 10, dropping the last digit
    LDR 8
    STR 0
    LDR 9
    STR 1
    LDR 10
    STR 2
    LDR 11
    STR 3
    JMP int32_read__erase_echo

int32_read__erase_sign:
    LDM 0x800B
    JA0 int32_read__done    // nothing left to erase -> end the number instead
    LDI 0
    STM 0x800B      // erase the leading '-' again

int32_read__erase_echo:
    CLL disp_bs
    JMP int32_read__loop

int32_read__done:
    LDM 0x800B
    JA0 int32_read__restore
    LDR 0           // a leading '-' was typed -> A = 0 - A
    STR 4
    LDR 1
    STR 5
    LDR 2
    STR 6
    LDR 3
    STR 7
    LDI 0
    STR 0
    STR 1
    STR 2
    STR 3
    CLL int32_sub
    LDR 8
    STR 0
    LDR 9
    STR 1
    LDR 10
    STR 2
    LDR 11
    STR 3

int32_read__restore:
    POP
    STR 11
    POP
    STR 10
    POP
    STR 9
    POP
    STR 8
    POP
    STR 7
    POP
    STR 6
    POP
    STR 5
    POP
    STR 4
    RET
