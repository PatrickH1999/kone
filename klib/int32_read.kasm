// int32_read: reads a decimal number from the keyboard (R16/R17) and echoes
// every typed char to the display; '.' and ',' are dropped, so numbers may be
// typed with thousands separators
//     in:       -
//     out:      A -> R0 - R3, byte order LSB -> MSB, R14 -> terminator char
//     clobbers: R12 - R15
//
// The accumulator is built up digit by digit as A = A * 10 + digit, using
// int32_mul and int32_add. Reading stops at the first char that is not a
// digit; that char is echoed as well and left in R14, so the caller can tell
// which key ended the number (kone maps ENTER to ' '). Echoing goes through
// 'disp_putc' from klib/int32_write.kasm.
int32_read:
    LDR 4
    PSH
    LDR 5
    PSH
    LDR 6
    PSH
    LDR 7
    PSH
    LDR 8
    PSH
    LDR 9
    PSH
    LDR 10
    PSH
    LDR 11
    PSH             // R4 - R11 are restored right before RET

    LDI 0
    STR 0
    STR 1
    STR 2
    STR 3

int32_read__loop:
    LDR 16          // keyboard set-bit
    JA0 int32_read__loop
    LDR 17
    STR 14          // received char
    LDI 0
    STR 16          // clear the set-bit -> acknowledge the char

    LDR 14
    STR 13
    LDI 210         // 256 - 46 -> '.' is a separator, drop it
    ADD 13
    JA0 int32_read__loop
    LDI 212         // 256 - 44 -> ',' is a separator, drop it
    ADD 13
    JA0 int32_read__loop

    LDR 14
    CLL disp_putc

    LDR 14
    STR 13
    LDI 208         // 256 - 48; carry set only for chars >= '0'
    ADD 13
    JC0 int32_read__done
    STR 15          // R15 = char - '0'
    LDI 246         // 256 - 10; carry set only for chars > '9'
    ADD 15
    JC1 int32_read__done

    LDI 10
    STR 4
    LDI 0
    STR 5
    STR 6
    STR 7
    CLL int32_mul   // R8 - R11 = A * 10
    LDR 8
    STR 0
    LDR 9
    STR 1
    LDR 10
    STR 2
    LDR 11
    STR 3

    LDR 15
    STR 4
    LDI 0
    STR 5
    STR 6
    STR 7
    CLL int32_add   // R8 - R11 = A * 10 + digit
    LDR 8
    STR 0
    LDR 9
    STR 1
    LDR 10
    STR 2
    LDR 11
    STR 3

    JMP int32_read__loop

int32_read__done:
    POP
    STR 11
    POP
    STR 10
    POP
    STR 9
    POP
    STR 8
    POP
    STR 7
    POP
    STR 6
    POP
    STR 5
    POP
    STR 4
    RET
