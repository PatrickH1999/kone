// float32_write: prints an IEEE 754 single precision value to the display as a
// decimal number, prefixed with '=' and followed by a newline
//     in:       A -> R0 - R3, byte order LSB -> MSB
//     out:      -
//     clobbers: R0 - R15
//
// Printing goes through 'disp_putc' and 'disp_nl' from klib/io/disp.kasm.
float32_write:
    LDI 61          // '='
    CLL disp_putc
    CLL float32_puts
    CLL disp_nl
    RET

// float32_puts: prints an IEEE 754 single precision value without the prefix
// and the newline that 'float32_write' puts around it
//     in:       A -> R0 - R3, byte order LSB -> MSB
//     out:      -
//     clobbers: R0 - R15
//
// Six significant digits are printed, trailing zeros are dropped, and the
// layout follows printf's '%g': positional while the decimal exponent is
// between -4 and 5, 'd.dddddemdd' outside that range. A zero prints as '0' and
// an exponent of 255 as 'inf' or 'nan'. The digits come from 'float32_digits'
// (see below), so the last one may be off by one, and six digits are too few
// to read the value back unchanged, which would take nine.
float32_puts:
    LDI 0x80
    STR 12
    LDR 3
    AND 12
    JA0 float32_puts__abs
    LDI 45          // '-'
    CLL disp_putc

float32_puts__abs:
    LDI 0x7F
    STR 12
    LDR 3
    AND 12
    STR 3

    LDI 0x01
    STR 15
    LDR 2
    BRL
    AND 15
    STR 14
    LDR 3
    BSL
    ORR 14
    STR 13
    JA0 float32_puts__zero
    LDI 1
    ADD 13
    JA0 float32_puts__special

    CLL float32_digits
    LDR 12
    STM 0x8020      // the decimal exponent
    CLL float32_puts__split

    LDI 6
    STM 0x801F
    LDM 0x801C
    JA1 float32_puts__layout
    LDI 5
    STM 0x801F
    LDM 0x801B
    JA1 float32_puts__layout
    LDI 4
    STM 0x801F
    LDM 0x801A
    JA1 float32_puts__layout
    LDI 3
    STM 0x801F
    LDM 0x8019
    JA1 float32_puts__layout
    LDI 2
    STM 0x801F
    LDM 0x8018
    JA1 float32_puts__layout
    LDI 1
    STM 0x801F

float32_puts__layout:
    LDM 0x801F
    STM 0x801D      // every significant digit is printed
    LDI 0
    STM 0x801E      // and no decimal point is placed yet
    STM 0x8021

    LDM 0x8020
    STR 13
    LDI 250         // - 6, negative for an exponent of 5 or less
    ADD 13
    STR 14
    LDI 0x80
    AND 14
    JA0 float32_puts__sci
    LDI 4           // + 4, negative for an exponent below -4
    ADD 13
    STR 14
    LDI 0x80
    AND 14
    JA1 float32_puts__sci

    LDI 0x80
    STR 14
    LDR 13
    AND 14
    JA1 float32_puts__small

    LDI 1
    ADD 13
    STM 0x801E      // E + 1 digits go before the point
    NOT
    STR 14
    LDI 1
    ADD 14
    STR 14
    LDM 0x801F
    ADD 14
    JC0 float32_puts__pad
    JA0 float32_puts__pad
    JMP float32_puts__digits

float32_puts__pad:
    LDM 0x801E
    STM 0x801D      // no digit is left over -> pad with zeros, print no point
    LDI 0
    STM 0x801E
    JMP float32_puts__digits

float32_puts__small:
    LDI 48          // '0'
    CLL disp_putc
    LDI 46          // '.'
    CLL disp_putc
    LDM 0x8020
    NOT
    STR 12          // - E - 1 leading zeros

float32_puts__lead:
    LDR 12
    JA0 float32_puts__digits
    LDI 255
    ADD 12
    STR 12
    LDI 48          // '0'
    CLL disp_putc
    JMP float32_puts__lead

float32_puts__sci:
    LDI 1
    STM 0x8021
    LDM 0x801F
    STR 13
    LDI 255
    ADD 13
    JA0 float32_puts__digits
    LDI 1
    STM 0x801E      // the point goes behind the first digit

float32_puts__digits:
    LDM 0x801D
    STR 13
    LDI 255
    ADD 13
    JC0 float32_puts__tail
    LDM 0x801F
    STR 13
    LDI 255
    ADD 13
    JC0 float32_puts__pad1
    LDM 0x8017
    STR 13
    LDI 48          // '0'
    ADD 13
    JMP float32_puts__put1

float32_puts__pad1:
    LDI 48          // '0'

float32_puts__put1:
    CLL disp_putc
    LDM 0x801E
    STR 13
    LDI 255
    ADD 13
    JA1 float32_puts__next1
    LDI 46          // '.'
    CLL disp_putc

float32_puts__next1:
    LDM 0x801D
    STR 13
    LDI 254
    ADD 13
    JC0 float32_puts__tail
    LDM 0x801F
    STR 13
    LDI 254
    ADD 13
    JC0 float32_puts__pad2
    LDM 0x8018
    STR 13
    LDI 48          // '0'
    ADD 13
    JMP float32_puts__put2

float32_puts__pad2:
    LDI 48          // '0'

float32_puts__put2:
    CLL disp_putc
    LDM 0x801E
    STR 13
    LDI 254
    ADD 13
    JA1 float32_puts__next2
    LDI 46          // '.'
    CLL disp_putc

float32_puts__next2:
    LDM 0x801D
    STR 13
    LDI 253
    ADD 13
    JC0 float32_puts__tail
    LDM 0x801F
    STR 13
    LDI 253
    ADD 13
    JC0 float32_puts__pad3
    LDM 0x8019
    STR 13
    LDI 48          // '0'
    ADD 13
    JMP float32_puts__put3

float32_puts__pad3:
    LDI 48          // '0'

float32_puts__put3:
    CLL disp_putc
    LDM 0x801E
    STR 13
    LDI 253
    ADD 13
    JA1 float32_puts__next3
    LDI 46          // '.'
    CLL disp_putc

float32_puts__next3:
    LDM 0x801D
    STR 13
    LDI 252
    ADD 13
    JC0 float32_puts__tail
    LDM 0x801F
    STR 13
    LDI 252
    ADD 13
    JC0 float32_puts__pad4
    LDM 0x801A
    STR 13
    LDI 48          // '0'
    ADD 13
    JMP float32_puts__put4

float32_puts__pad4:
    LDI 48          // '0'

float32_puts__put4:
    CLL disp_putc
    LDM 0x801E
    STR 13
    LDI 252
    ADD 13
    JA1 float32_puts__next4
    LDI 46          // '.'
    CLL disp_putc

float32_puts__next4:
    LDM 0x801D
    STR 13
    LDI 251
    ADD 13
    JC0 float32_puts__tail
    LDM 0x801F
    STR 13
    LDI 251
    ADD 13
    JC0 float32_puts__pad5
    LDM 0x801B
    STR 13
    LDI 48          // '0'
    ADD 13
    JMP float32_puts__put5

float32_puts__pad5:
    LDI 48          // '0'

float32_puts__put5:
    CLL disp_putc
    LDM 0x801E
    STR 13
    LDI 251
    ADD 13
    JA1 float32_puts__next5
    LDI 46          // '.'
    CLL disp_putc

float32_puts__next5:
    LDM 0x801D
    STR 13
    LDI 250
    ADD 13
    JC0 float32_puts__tail
    LDM 0x801F
    STR 13
    LDI 250
    ADD 13
    JC0 float32_puts__pad6
    LDM 0x801C
    STR 13
    LDI 48          // '0'
    ADD 13
    JMP float32_puts__put6

float32_puts__pad6:
    LDI 48          // '0'

float32_puts__put6:
    CLL disp_putc
    LDM 0x801E
    STR 13
    LDI 250
    ADD 13
    JA1 float32_puts__next6
    LDI 46          // '.'
    CLL disp_putc

float32_puts__next6:
float32_puts__tail:
    LDM 0x8021
    JA0 float32_puts__done

    LDI 101         // 'e'
    CLL disp_putc
    LDM 0x8020
    STR 13
    LDI 0x80
    AND 13
    JA0 float32_puts__eplus
    LDI 45          // '-'
    CLL disp_putc
    LDM 0x8020      // disp_putc clobbers R13
    NOT
    STR 12
    LDI 1
    ADD 12
    STR 12
    JMP float32_puts__etens

float32_puts__eplus:
    LDI 43          // '+'
    CLL disp_putc
    LDM 0x8020
    STR 12

float32_puts__etens:
    LDI 0
    STR 13

float32_puts__eloop:
    LDI 246         // - 10
    ADD 12
    JC0 float32_puts__eput
    STR 12
    LDI 1
    ADD 13
    STR 13
    JMP float32_puts__eloop

float32_puts__eput:
    LDI 48          // '0'
    ADD 13
    CLL disp_putc
    LDI 48          // '0'
    ADD 12
    CLL disp_putc

float32_puts__done:
    RET

float32_puts__zero:
    LDI 48          // '0'
    CLL disp_putc
    RET

float32_puts__special:
    LDR 0
    ORR 1
    STR 14
    LDI 0x7F
    STR 15
    LDR 2
    AND 15
    ORR 14
    JA1 float32_puts__qnan
    LDI 105         // 'i'
    CLL disp_putc
    LDI 110         // 'n'
    CLL disp_putc
    LDI 102         // 'f'
    CLL disp_putc
    RET

float32_puts__qnan:
    LDI 110         // 'n'
    CLL disp_putc
    LDI 97          // 'a'
    CLL disp_putc
    LDI 110         // 'n'
    CLL disp_putc
    RET

// float32_puts__split: cuts the six digit value in R8 - R11 into single digits
//     in:       v -> R8 - R11, 100000 to 999999
//     out:      the six digits at 0x8017 - 0x801C, most significant first
//     clobbers: R0 - R2, R4 - R6, R8 - R10, R13 - R15
float32_puts__split:
    LDR 8
    STR 0
    LDR 9
    STR 1
    LDR 10
    STR 2

    LDI 0xA0
    STR 4
    LDI 0x86
    STR 5
    LDI 0x01
    STR 6
    CLL float32_puts__count
    STM 0x8017      // 100000

    LDI 0x10
    STR 4
    LDI 0x27
    STR 5
    LDI 0x00
    STR 6
    CLL float32_puts__count
    STM 0x8018      // 10000

    LDI 0xE8
    STR 4
    LDI 0x03
    STR 5
    LDI 0x00
    STR 6
    CLL float32_puts__count
    STM 0x8019      // 1000

    LDI 0x64
    STR 4
    LDI 0x00
    STR 5
    LDI 0x00
    STR 6
    CLL float32_puts__count
    STM 0x801A      // 100

    LDI 0x0A
    STR 4
    LDI 0x00
    STR 5
    LDI 0x00
    STR 6
    CLL float32_puts__count
    STM 0x801B      // 10

    LDI 0x01
    STR 4
    LDI 0x00
    STR 5
    LDI 0x00
    STR 6
    CLL float32_puts__count
    STM 0x801C      // 1

    RET

// float32_puts__count: how often the power of ten in R4 - R6 fits into the
// remainder in R0 - R2, subtracting it off as it counts
//     out:      digit -> accumulator, remainder -> R0 - R2
//     clobbers: R8 - R10, R13 - R15
float32_puts__count:
    LDI 0
    STR 13

float32_puts__count_loop:
    LDI 1
    STR 15

    LDR 4
    NOT
    STR 14
    LDR 0
    ADD 15
    STR 8
    LDR 26
    STR 15
    LDR 8
    ADD 14
    STR 8
    LDR 26
    ADD 15
    STR 15

    LDR 5
    NOT
    STR 14
    LDR 1
    ADD 15
    STR 9
    LDR 26
    STR 15
    LDR 9
    ADD 14
    STR 9
    LDR 26
    ADD 15
    STR 15

    LDR 6
    NOT
    STR 14
    LDR 2
    ADD 15
    STR 10
    LDR 26
    STR 15
    LDR 10
    ADD 14
    STR 10
    LDR 26
    ADD 15
    STR 15

    LDR 15
    JA0 float32_puts__count_done
    LDR 8
    STR 0
    LDR 9
    STR 1
    LDR 10
    STR 2
    LDI 1
    ADD 13
    STR 13
    JMP float32_puts__count_loop

float32_puts__count_done:
    LDR 13
    RET

// float32_digits: the magnitude of an IEEE 754 single precision value as six
// decimal digits and a decimal exponent
//     in:       A -> R0 - R3, neither zero nor exponent 255
//     out:      v -> R8 - R11, 100000 to 999999, E -> R12, two's complement,
//               so that the magnitude of A is about v * 10 ** (E - 5)
//     clobbers: R0 - R7, R12 - R15
//
// The value is scaled by a power of ten until it lands between 1e5 and 1e6,
// which takes at most two multiplications or one division once the decimal
// exponent has been estimated from the binary one; 77/256 is close enough to
// log10(2) for that, and the two loops behind it mop up the rest. Every step
// truncates, so the sixth digit can be off by one.
float32_digits:
    LDR 0
    STM 0x8011
    LDR 1
    STM 0x8012
    LDR 2
    STM 0x8013
    LDI 0x7F
    STR 14
    LDR 3
    AND 14
    STM 0x8014      // the working value, sign cleared

    LDI 0x01
    STR 15
    LDR 2
    BRL
    AND 15
    STR 14
    LDR 3
    BSL
    ORR 14
    STR 13

    LDI 129         // - 127, the exponent bias
    ADD 13
    STR 14
    JC1 float32_digits__epos
    LDR 14
    NOT
    STR 14
    LDI 1
    ADD 14
    STR 14
    LDI 1
    STR 15
    JMP float32_digits__est

float32_digits__epos:
    LDI 0
    STR 15

float32_digits__est:
    LDI 0
    STR 4
    STR 5
    LDI 77          // 77/256 is close enough to log10(2)
    STR 6

float32_digits__estloop:
    LDR 6
    JA0 float32_digits__estdone
    LDI 255
    ADD 6
    STR 6
    LDR 4
    ADD 14
    STR 4
    LDR 26
    ADD 5
    STR 5
    JMP float32_digits__estloop

float32_digits__estdone:
    LDR 15
    JA0 float32_digits__estpos
    LDR 5
    NOT
    STR 5
    LDI 1
    ADD 5
    STR 5

float32_digits__estpos:
    LDR 5
    STM 0x8015      // the estimated decimal exponent
    NOT
    STR 13
    LDI 1
    ADD 13
    STR 13
    LDI 5
    ADD 13
    STM 0x8016      // 5 - E, the power of ten still to apply

float32_digits__scale:
    LDM 0x8016
    JA0 float32_digits__high
    STR 13
    LDI 0x80
    AND 13
    JA1 float32_digits__down

    LDI 234         // - 22, the largest chunk that cannot overflow
    ADD 13
    JC1 float32_digits__up22
    LDR 13
    STR 0
    LDI 0
    STM 0x8016
    JMP float32_digits__mul

float32_digits__up22:
    LDI 22
    STR 0
    LDI 234
    ADD 13
    STM 0x8016
    JMP float32_digits__mul

float32_digits__down:
    LDR 13
    NOT
    STR 14
    LDI 1
    ADD 14
    STR 14
    LDI 234         // - 22
    ADD 14
    JC1 float32_digits__down22
    LDR 14
    STR 0
    LDI 0
    STM 0x8016
    JMP float32_digits__div

float32_digits__down22:
    LDI 22
    STR 0
    LDI 22
    ADD 13
    STM 0x8016
    JMP float32_digits__div

float32_digits__mul:
    CLL float32_pow10
    LDR 8
    STR 4
    LDR 9
    STR 5
    LDR 10
    STR 6
    LDR 11
    STR 7
    LDM 0x8011
    STR 0
    LDM 0x8012
    STR 1
    LDM 0x8013
    STR 2
    LDM 0x8014
    STR 3
    CLL float32_mul
    LDR 8
    STM 0x8011
    LDR 9
    STM 0x8012
    LDR 10
    STM 0x8013
    LDR 11
    STM 0x8014
    JMP float32_digits__scale

float32_digits__div:
    CLL float32_pow10
    LDR 8
    STR 4
    LDR 9
    STR 5
    LDR 10
    STR 6
    LDR 11
    STR 7
    LDM 0x8011
    STR 0
    LDM 0x8012
    STR 1
    LDM 0x8013
    STR 2
    LDM 0x8014
    STR 3
    CLL float32_div
    LDR 8
    STM 0x8011
    LDR 9
    STM 0x8012
    LDR 10
    STM 0x8013
    LDR 11
    STM 0x8014
    JMP float32_digits__scale

float32_digits__high:
    LDM 0x8011
    STR 0
    LDM 0x8012
    STR 1
    LDM 0x8013
    STR 2
    LDM 0x8014
    STR 3
    LDI 0x00
    STR 4
    LDI 0x24
    STR 5
    LDI 0x74
    STR 6
    LDI 0x49
    STR 7           // 1e6
    CLL float32_digits__ge
    LDR 15
    JA0 float32_digits__low
    LDM 0x8011
    STR 0
    LDM 0x8012
    STR 1
    LDM 0x8013
    STR 2
    LDM 0x8014
    STR 3
    LDI 0x00
    STR 4
    STR 5
    LDI 0x20
    STR 6
    LDI 0x41
    STR 7           // 10
    CLL float32_div
    LDR 8
    STM 0x8011
    LDR 9
    STM 0x8012
    LDR 10
    STM 0x8013
    LDR 11
    STM 0x8014
    LDM 0x8015
    STR 13
    LDI 1
    ADD 13
    STM 0x8015
    JMP float32_digits__high

float32_digits__low:
    LDM 0x8011
    STR 0
    LDM 0x8012
    STR 1
    LDM 0x8013
    STR 2
    LDM 0x8014
    STR 3
    LDI 0x00
    STR 4
    LDI 0x50
    STR 5
    LDI 0xC3
    STR 6
    LDI 0x47
    STR 7           // 1e5
    CLL float32_digits__ge
    LDR 15
    JA1 float32_digits__round
    LDM 0x8011
    STR 0
    LDM 0x8012
    STR 1
    LDM 0x8013
    STR 2
    LDM 0x8014
    STR 3
    LDI 0x00
    STR 4
    STR 5
    LDI 0x20
    STR 6
    LDI 0x41
    STR 7           // 10
    CLL float32_mul
    LDR 8
    STM 0x8011
    LDR 9
    STM 0x8012
    LDR 10
    STM 0x8013
    LDR 11
    STM 0x8014
    LDM 0x8015
    STR 13
    LDI 255
    ADD 13
    STM 0x8015
    JMP float32_digits__low

float32_digits__round:
    LDM 0x8011
    STR 0
    LDM 0x8012
    STR 1
    LDM 0x8013
    STR 2
    LDM 0x8014
    STR 3
    LDI 0x00
    STR 4
    STR 5
    STR 6
    LDI 0x3F
    STR 7           // 0.5
    CLL float32_add
    LDR 8
    STR 0
    LDR 9
    STR 1
    LDR 10
    STR 2
    LDR 11
    STR 3
    CLL float32_to_int32

    LDI 0x40
    STR 0
    LDI 0x42
    STR 1
    LDI 0x0F
    STR 2
    LDI 0x00
    STR 3           // 1000000, which rounding up can just reach
    LDR 8
    XOR 0
    STR 12
    LDR 9
    XOR 1
    ORR 12
    STR 12
    LDR 10
    XOR 2
    ORR 12
    STR 12
    LDR 11
    XOR 3
    ORR 12
    JA1 float32_digits__done
    LDI 0xA0
    STR 8
    LDI 0x86
    STR 9
    LDI 0x01
    STR 10
    LDI 0x00
    STR 11          // 100000, one decimal exponent higher
    LDM 0x8015
    STR 12
    LDI 1
    ADD 12
    STM 0x8015

float32_digits__done:
    LDM 0x8015
    STR 12
    RET

// float32_digits__ge: compares two positive single precision values; their bit
// patterns are ordered like the values themselves, so an unsigned 32 bit
// compare does the job
//     in:       A -> R0 - R3, B -> R4 - R7, both positive
//     out:      R15 = 1 if A >= B, 0 otherwise
//     clobbers: R8 - R11, R14, R15
float32_digits__ge:
    LDI 1
    STR 15

    LDR 4
    NOT
    STR 14
    LDR 0
    ADD 15
    STR 8
    LDR 26
    STR 15
    LDR 8
    ADD 14
    STR 8
    LDR 26
    ADD 15
    STR 15

    LDR 5
    NOT
    STR 14
    LDR 1
    ADD 15
    STR 9
    LDR 26
    STR 15
    LDR 9
    ADD 14
    STR 9
    LDR 26
    ADD 15
    STR 15

    LDR 6
    NOT
    STR 14
    LDR 2
    ADD 15
    STR 10
    LDR 26
    STR 15
    LDR 10
    ADD 14
    STR 10
    LDR 26
    ADD 15
    STR 15

    LDR 7
    NOT
    STR 14
    LDR 3
    ADD 15
    STR 11
    LDR 26
    STR 15
    LDR 11
    ADD 14
    STR 11
    LDR 26
    ADD 15
    STR 15

    RET
