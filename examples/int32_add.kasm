// Adds two hardcoded 32 bit numbers with klib's int32_add and prints the
// equation as hex: "DEADBEEF + 12345678 = F0E21567"

main:
    LDI 0x0F
    STR 15          // nibble mask for print_nibble

    LDI 0xFF
    STR 0
    LDI 0x00
    STR 1
    LDI 0x00
    STR 2
    LDI 0x00
    STR 3

    LDI 0xFF
    STR 4
    LDI 0x00
    STR 5
    LDI 0x00
    STR 6
    LDI 0x00
    STR 7

    CLL int32_add

    LDR 3
    STR 13
    CLL print_hex8
    LDR 2
    STR 13
    CLL print_hex8
    LDR 1
    STR 13
    CLL print_hex8
    LDR 0
    STR 13
    CLL print_hex8

    LDI 32
    CLL print_char
    LDI 43
    CLL print_char
    LDI 32
    CLL print_char

    LDR 7
    STR 13
    CLL print_hex8
    LDR 6
    STR 13
    CLL print_hex8
    LDR 5
    STR 13
    CLL print_hex8
    LDR 4
    STR 13
    CLL print_hex8

    LDI 32
    CLL print_char
    LDI 61
    CLL print_char
    LDI 32
    CLL print_char

    LDR 11
    STR 13
    CLL print_hex8
    LDR 10
    STR 13
    CLL print_hex8
    LDR 9
    STR 13
    CLL print_hex8
    LDR 8
    STR 13
    CLL print_hex8

halt:
    JMP halt

// print_hex8: prints the byte in R13 as two hex digits
//     clobbers: R14
print_hex8:
    LDR 13
    BSR
    BSR
    BSR
    BSR
    STR 14
    CLL print_nibble
    LDR 13
    STR 14
    CLL print_nibble
    RET

// print_nibble: prints the low nibble of R14 as one hex digit, R15 = 0x0F
print_nibble:
    LDR 14
    AND 15
    STR 14
    LDI 246
    ADD 14          // carry set -> nibble >= 10 -> 'A' - 'F'
    JC1 print_nibble__letter
    LDI 48
    JMP print_nibble__emit
print_nibble__letter:
    LDI 55
print_nibble__emit:
    ADD 14
    CLL print_char
    RET

// print_char: pushes the ASCII char in the accumulator to the display
print_char:
    STR 19
    LDI 1
    STR 18
print_char__wait:
    LDR 18
    JA1 print_char__wait
    RET

.include "../klib/math.kasm"
