// examples/calculator_int32.kasm on IEEE 754 single precision values, built
// from klib's float32_read and float32_puts; the wiki's Examples page
// documents how a line is read.
//
// Scratch memory, above the 0x8000 - 0x803F klib maps in klib/io/disp.kasm:
//     0x8040          the operator of the line being read
//     0x8041 - 0x8044 the accumulator
//     0x8045          chars of a function name on the display, '(' included

    JMP main

.include "../klib/io/disp.kasm"
.include "../klib/math/int32.kasm"
.include "../klib/math/float32.kasm"
.include "../klib/io/float32_write.kasm"
.include "../klib/io/float32_read.kasm"

// main: the first prompt of the run; every later line opens in
// 'calculator_float32__next', once the result before it has been read
main:
    LDI 62          // '>'
    CLL disp_putc

calculator_float32__key:
    CLL calculator_float32__read_key
    STR 13
    LDI 129         // 256 - 127 -> DEL, nothing typed yet -> ignore it
    ADD 13
    JA0 calculator_float32__key
    LDI 248         // 256 - 8 -> BS, same
    ADD 13
    JA0 calculator_float32__key

calculator_float32__dispatch:
    LDI 210         // 256 - 46 -> '.', '.5' is a number as well
    ADD 13
    JA0 calculator_float32__number
    LDI 208         // 256 - 48; carry set only for chars >= '0'
    ADD 13
    JC0 calculator_float32__operator
    STR 12
    LDI 246         // 256 - 10; carry set only for chars > '9'
    ADD 12
    JC1 calculator_float32__operator

// calculator_float32__number: the line starts a number, so hand the first char
// back to the keyboard for float32_read to read (and echo) it, and let the
// number it returns replace the accumulator
calculator_float32__number:
    LDR 13
    STR 17
    LDI 1
    STR 16
    CLL float32_read
    CLL calculator_float32__erased
    JA1 calculator_float32__key     // erased back past the first char
    CLL disp_nl
    LDR 0
    STM 0x8041
    LDR 1
    STM 0x8042
    LDR 2
    STM 0x8043
    LDR 3
    STM 0x8044
    JMP calculator_float32__print

calculator_float32__operator:
    LDI 148         // 256 - 108 -> 'l'
    ADD 13
    JA0 calculator_float32__ln
    LDI 155         // 256 - 101 -> 'e'
    ADD 13
    JA0 calculator_float32__exp
    LDR 13
    STM 0x8040      // float32_read clobbers every register, so park it here
    CLL disp_putc

    CLL float32_read    // R0 - R3 = operand
    CLL calculator_float32__erased
    JA1 calculator_float32__cancel  // erased back past the operator
    CLL disp_nl

    LDR 0
    STR 4
    LDR 1
    STR 5
    LDR 2
    STR 6
    LDR 3
    STR 7           // R4 - R7 = operand
    LDM 0x8041
    STR 0
    LDM 0x8042
    STR 1
    LDM 0x8043
    STR 2
    LDM 0x8044
    STR 3           // R0 - R3 = accumulator

    LDM 0x8040
    STR 13
    LDI 213         // 256 - 43 -> '+'
    ADD 13
    JA0 calculator_float32__add
    LDI 211         // 256 - 45 -> '-'
    ADD 13
    JA0 calculator_float32__sub
    LDI 214         // 256 - 42 -> '*'
    ADD 13
    JA0 calculator_float32__mul
    LDI 209         // 256 - 47 -> '/'
    ADD 13
    JA0 calculator_float32__div
    LDI 162         // 256 - 94 -> '^'
    ADD 13
    JA0 calculator_float32__pow
    JMP calculator_float32__print   // unknown operator -> unchanged

calculator_float32__add:
    CLL float32_add
    JMP calculator_float32__store

calculator_float32__sub:
    CLL float32_sub
    JMP calculator_float32__store

calculator_float32__mul:
    CLL float32_mul
    JMP calculator_float32__store

// calculator_float32__div: klib's float32_div sorts the signs out on its own,
// so only the divisor has to be checked; both +0 and -0 count as zero, hence
// the sign bit is masked off first
calculator_float32__div:
    LDI 0x7F
    STR 12
    LDR 7
    AND 12
    STR 12
    LDR 4
    ORR 5
    ORR 6
    ORR 12
    JA0 calculator_float32__err
    CLL float32_div
    JMP calculator_float32__store

calculator_float32__pow:
    CLL float32_pow
    JA1 calculator_float32__err     // undefined, e.g. a root of a negative
    JMP calculator_float32__store

// calculator_float32__ln: 'ln(' and 'exp(' start a function line; the name is
// echoed as it is typed, and a backspace or any other char takes it back off
// the display again
calculator_float32__ln:
    LDI 108         // 'l'
    STM 0x8040
    CLL disp_putc
    LDI 1
    STM 0x8045
    LDI 110         // 'n'
    STR 15
    CLL calculator_float32__expect
    JA1 calculator_float32__unname
    JMP calculator_float32__paren

calculator_float32__exp:
    LDI 101         // 'e'
    STM 0x8040
    CLL disp_putc
    LDI 1
    STM 0x8045
    LDI 120         // 'x'
    STR 15
    CLL calculator_float32__expect
    JA1 calculator_float32__unname
    LDI 112         // 'p'
    STR 15
    CLL calculator_float32__expect
    JA1 calculator_float32__unname

// calculator_float32__paren: an argument replaces the accumulator, an empty
// one -- ')' or Enter straight after '(' -- applies the function to it
calculator_float32__paren:
    LDI 40          // '('
    STR 15
    CLL calculator_float32__expect
    JA1 calculator_float32__unname
    CLL calculator_float32__read_key
    STR 13
    LDI 215         // 256 - 41 -> ')'
    ADD 13
    JA0 calculator_float32__close
    LDI 246         // 256 - 10 -> Enter
    ADD 13
    JA0 calculator_float32__self
    LDI 129         // 256 - 127 -> DEL
    ADD 13
    JA0 calculator_float32__unname
    LDI 248         // 256 - 8 -> BS
    ADD 13
    JA0 calculator_float32__unname
    LDR 13
    STR 17
    LDI 1
    STR 16          // hand the char back to float32_read
    CLL float32_read    // R0 - R3 = argument, ended by ')' or anything else
    CLL calculator_float32__erased
    JA1 calculator_float32__unname  // erased back past '('
    JMP calculator_float32__apply

calculator_float32__close:
    LDI 41          // ')'
    CLL disp_putc

calculator_float32__self:
    LDM 0x8041
    STR 0
    LDM 0x8042
    STR 1
    LDM 0x8043
    STR 2
    LDM 0x8044
    STR 3

calculator_float32__apply:
    CLL disp_nl
    LDM 0x8040
    STR 13
    LDI 155         // 256 - 101 -> 'e'
    ADD 13
    JA0 calculator_float32__apply_exp
    LDI 0x80
    STR 12
    LDR 3
    AND 12
    JA1 calculator_float32__err     // ln of a negative
    LDI 0x7F
    STR 12
    LDR 3
    AND 12
    ORR 2
    ORR 1
    ORR 0
    JA0 calculator_float32__err     // ln 0
    CLL float32_ln
    JMP calculator_float32__store

// calculator_float32__apply_exp: an e^x beyond the range comes back as +inf,
// which, as with a division by zero, is an error rather than a result
calculator_float32__apply_exp:
    CLL float32_exp
    LDI 0x7F
    STR 12
    LDR 11
    AND 12
    STR 12
    LDI 129         // 256 - 0x7F
    ADD 12
    JA1 calculator_float32__store
    LDI 0x80
    STR 12
    LDR 10
    AND 12
    JA1 calculator_float32__err
    JMP calculator_float32__store

// calculator_float32__unname: takes the function name back off the display
// and reads the line from the start
calculator_float32__unname:
    LDM 0x8045
    JA0 calculator_float32__key
    CLL disp_bs
    LDM 0x8045
    STR 12
    LDI 255         // 256 - 1
    ADD 12
    STM 0x8045
    JMP calculator_float32__unname

calculator_float32__err:
    LDI 69          // 'E'
    CLL disp_putc
    LDI 82          // 'R'
    CLL disp_putc
    LDI 82          // 'R'
    CLL disp_putc
    JMP calculator_float32__next

calculator_float32__store:
    LDR 8
    STM 0x8041
    LDR 9
    STM 0x8042
    LDR 10
    STM 0x8043
    LDR 11
    STM 0x8044

// calculator_float32__print: prints the accumulator but leaves its row open --
// float32_write ends the row, and ending the last one clears the display,
// which is what used to wipe a result the moment it appeared
calculator_float32__print:
    LDM 0x8041
    STR 0
    LDM 0x8042
    STR 1
    LDM 0x8043
    STR 2
    LDM 0x8044
    STR 3
    LDI 61          // '='
    CLL disp_putc
    CLL float32_puts

// calculator_float32__next: the result stays on the display until a key is
// pressed; that key opens the line under it and is then dispatched as its first
calculator_float32__next:
    CLL calculator_float32__read_key
    STR 14
    LDI 129         // 256 - 127 -> DEL, nothing to erase -> ignore it
    ADD 14
    JA0 calculator_float32__next
    LDI 248         // 256 - 8 -> BS, same
    ADD 14
    JA0 calculator_float32__next
    CLL calculator_float32__newline
    LDI 62          // '>'
    CLL disp_putc
    LDR 14
    STR 13
    JMP calculator_float32__dispatch

// calculator_float32__newline: opens the row the next line goes on, clearing
// the display when the line and the result under it would no longer fit
//     clobbers: R13
calculator_float32__newline:
    LDM 0x8022
    STR 13
    LDI 254         // 256 - 2; carry set only on the last two rows
    ADD 13
    JC1 disp_cls    // both end in RET, so both return to this routine's caller
    JMP disp_nl

// calculator_float32__cancel: the operand was erased away, so take the operator
// off the display again and read the line from the start
calculator_float32__cancel:
    CLL disp_bs
    JMP calculator_float32__key

// calculator_float32__erased: tells whether float32_read stopped on a
// backspace, which it does once there is nothing left to erase
//     in:       terminator -> R14
//     out:      accumulator = 0 if the number ended some other way
//     clobbers: R13
calculator_float32__erased:
    LDR 14
    STR 13
    LDI 129         // 256 - 127 -> DEL
    ADD 13
    JA0 calculator_float32__erased_yes
    LDI 248         // 256 - 8 -> BS
    ADD 13
    JA0 calculator_float32__erased_yes
    LDI 0
    RET

calculator_float32__erased_yes:
    LDI 1
    RET

// calculator_float32__expect: reads a key and echoes it if it is the next
// char of a function name
//     in:       char -> R15
//     out:      accumulator = 0 if it was, 1 if not
//     clobbers: R12 - R14
calculator_float32__expect:
    CLL calculator_float32__read_key
    STR 14
    LDR 15
    NOT
    STR 12
    LDI 1
    ADD 12
    ADD 14          // key - char
    JA1 calculator_float32__expect_no
    LDR 14
    CLL disp_putc
    LDM 0x8045
    STR 12
    LDI 1
    ADD 12
    STM 0x8045
    LDI 0
    RET

calculator_float32__expect_no:
    LDI 1
    RET

// calculator_float32__read_key: waits for a key press and returns its char
//     out:      char -> accumulator
//     clobbers: R12
calculator_float32__read_key:
    LDR 16
    JA0 calculator_float32__read_key
    LDR 17
    STR 12
    LDI 0
    STR 16          // clear the set-bit -> acknowledge the char
    LDR 12
    RET
