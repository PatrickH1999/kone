// Adds hardcoded 32 bit numbers with klib's int32_add and prints every
// equation as hex, one per display row:
//     12345678 + 9ABCDEF0 = ACF13568
//     000000FF + 00000001 = 00000100
//     FFFFFFFF + 00000001 = 00000000
//     00FFFFFF + 00000001 = 01000000
//     DEADBEEF + 12345678 = F0E21567

    JMP main

.include "../klib/math.kasm"

main:
    LDI 0x0F
    STR 15          // nibble mask for print_nibble

    LDI 0x78
    STR 0
    LDI 0x56
    STR 1
    LDI 0x34
    STR 2
    LDI 0x12
    STR 3
    LDI 0xF0
    STR 4
    LDI 0xDE
    STR 5
    LDI 0xBC
    STR 6
    LDI 0x9A
    STR 7
    CLL run

    LDI 0xFF
    STR 0
    LDI 0x00
    STR 1
    LDI 0x00
    STR 2
    LDI 0x00
    STR 3
    LDI 0x01
    STR 4
    LDI 0x00
    STR 5
    LDI 0x00
    STR 6
    LDI 0x00
    STR 7
    CLL run

    LDI 0xFF
    STR 0
    LDI 0xFF
    STR 1
    LDI 0xFF
    STR 2
    LDI 0xFF
    STR 3
    LDI 0x01
    STR 4
    LDI 0x00
    STR 5
    LDI 0x00
    STR 6
    LDI 0x00
    STR 7
    CLL run

    LDI 0xFF
    STR 0
    LDI 0xFF
    STR 1
    LDI 0xFF
    STR 2
    LDI 0x00
    STR 3
    LDI 0x01
    STR 4
    LDI 0x00
    STR 5
    LDI 0x00
    STR 6
    LDI 0x00
    STR 7
    CLL run

    LDI 0xEF
    STR 0
    LDI 0xBE
    STR 1
    LDI 0xAD
    STR 2
    LDI 0xDE
    STR 3
    LDI 0x78
    STR 4
    LDI 0x56
    STR 5
    LDI 0x34
    STR 6
    LDI 0x12
    STR 7
    CLL run

halt:
    JMP halt

// run: calls int32_add and prints "A + B = C", padded to one display row
run:
    CLL print_a
    LDI 32
    CLL print_char
    LDI 43
    CLL print_char
    LDI 32
    CLL print_char
    CLL print_b

    CLL int32_add

    LDI 32
    CLL print_char
    LDI 61
    CLL print_char
    LDI 32
    CLL print_char
    CLL print_c
    CLL print_pad
    RET

// print_a: prints R0 - R3 as hex, MSB first
print_a:
    LDR 3
    STR 13
    CLL print_hex8
    LDR 2
    STR 13
    CLL print_hex8
    LDR 1
    STR 13
    CLL print_hex8
    LDR 0
    STR 13
    CLL print_hex8
    RET

// print_b: prints R4 - R7 as hex, MSB first
print_b:
    LDR 7
    STR 13
    CLL print_hex8
    LDR 6
    STR 13
    CLL print_hex8
    LDR 5
    STR 13
    CLL print_hex8
    LDR 4
    STR 13
    CLL print_hex8
    RET

// print_c: prints R8 - R11 as hex, MSB first
print_c:
    LDR 11
    STR 13
    CLL print_hex8
    LDR 10
    STR 13
    CLL print_hex8
    LDR 9
    STR 13
    CLL print_hex8
    LDR 8
    STR 13
    CLL print_hex8
    RET

// print_pad: fills the rest of the current display row with spaces
print_pad:
    LDI 10
    STR 14
print_pad__loop:
    LDI 32
    CLL print_char
    LDI 255
    ADD 14
    STR 14
    JA1 print_pad__loop
    RET

// print_hex8: prints the byte in R13 as two hex digits
//     clobbers: R14
print_hex8:
    LDR 13
    BSR
    BSR
    BSR
    BSR
    STR 14
    CLL print_nibble
    LDR 13
    STR 14
    CLL print_nibble
    RET

// print_nibble: prints the low nibble of R14 as one hex digit, R15 = 0x0F
print_nibble:
    LDR 14
    AND 15
    STR 14
    LDI 246
    ADD 14          // carry set -> nibble >= 10 -> 'A' - 'F'
    JC1 print_nibble__letter
    LDI 48
    JMP print_nibble__emit
print_nibble__letter:
    LDI 55
print_nibble__emit:
    ADD 14
    CLL print_char
    RET

// print_char: pushes the ASCII char in the accumulator to the display
print_char:
    STR 19
    LDI 1
    STR 18
print_char__wait:
    LDR 18
    JA1 print_char__wait
    RET
