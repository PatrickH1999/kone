// An interactive 32 bit signed integer calculator, printed by klib's
// int32_puts; the wiki's Examples page documents the lines it takes. A line is
// typed into a buffer and only parsed once Enter ends it.
//
// Scratch memory, above the 0x8000 - 0x803F klib maps in klib/io/disp.kasm:
//     0x8040          the operator of the line
//     0x8041 - 0x8044 the accumulator
//     0x8045          chars in the line buffer
//     0x8046          the parse index into it
//     0x8047          number: 1 if a leading '-' was read
//     0x8048          number: 1 once a digit was read
//     0x8049 - 0x804C number: the magnitude so far
//     0x8060 - 0x8072 the line buffer, null terminated once Enter is read

    JMP main

.include "../klib/io/disp.kasm"
.include "../klib/math/int32.kasm"
.include "../klib/io/int32_write.kasm"
.include "../klib/mem/mem_peek.kasm"
.include "../klib/mem/mem_poke.kasm"

// main: the first prompt of the run; every later line opens in
// 'calculator_int32__next', once the result before it has been read
main:
    LDI 62          // '>'
    CLL disp_putc
    LDI 0
    STM 0x8045

calculator_int32__key:
    CLL calculator_int32__read_key
    STR 14

// calculator_int32__char: Enter ends the line, a backspace takes the last
// char back, anything else is echoed and buffered while the row has room
calculator_int32__char:
    LDI 246         // 256 - 10 -> Enter
    ADD 14
    JA0 calculator_int32__eval
    LDI 129         // 256 - 127 -> DEL
    ADD 14
    JA0 calculator_int32__erase
    LDI 248         // 256 - 8 -> BS
    ADD 14
    JA0 calculator_int32__erase
    LDM 0x8045
    STR 13
    LDI 238         // 256 - 18; carry set once '>' and the line fill 19 cells
    ADD 13
    JC1 calculator_int32__key
    LDI 0x60
    ADD 13
    STR 12
    LDI 0x80
    STR 13
    CLL mem_poke
    LDM 0x8045
    STR 13
    LDI 1
    ADD 13
    STM 0x8045
    LDR 14
    CLL disp_putc
    JMP calculator_int32__key

calculator_int32__erase:
    LDM 0x8045
    JA0 calculator_int32__key
    STR 13
    LDI 255         // 256 - 1
    ADD 13
    STM 0x8045
    CLL disp_bs
    JMP calculator_int32__key

// calculator_int32__eval: the first char picks the pattern, and any char the
// pattern has no room for makes the whole line an error
calculator_int32__eval:
    LDM 0x8045
    STR 13
    LDI 0x60
    ADD 13
    STR 12
    LDI 0x80
    STR 13
    LDI 0
    STR 14
    CLL mem_poke
    LDI 0
    STM 0x8046
    CLL disp_nl
    CLL calculator_int32__peek
    JA0 calculator_int32__print     // blank line
    STR 14
    STM 0x8040
    LDI 213         // 256 - 43 -> '+'
    ADD 14
    JA0 calculator_int32__operator
    LDI 211         // 256 - 45 -> '-'
    ADD 14
    JA0 calculator_int32__operator
    LDI 214         // 256 - 42 -> '*'
    ADD 14
    JA0 calculator_int32__operator
    LDI 209         // 256 - 47 -> '/'
    ADD 14
    JA0 calculator_int32__operator
    LDI 162         // 256 - 94 -> '^'
    ADD 14
    JA0 calculator_int32__operator

    CLL calculator_int32__number
    JA1 calculator_int32__err
    CLL calculator_int32__peek
    JA1 calculator_int32__err       // something behind the number
    LDR 0
    STM 0x8041
    LDR 1
    STM 0x8042
    LDR 2
    STM 0x8043
    LDR 3
    STM 0x8044
    JMP calculator_int32__print

calculator_int32__operator:
    CLL calculator_int32__skip
    CLL calculator_int32__number
    JA1 calculator_int32__err
    CLL calculator_int32__peek
    JA1 calculator_int32__err

    LDR 0
    STR 4
    LDR 1
    STR 5
    LDR 2
    STR 6
    LDR 3
    STR 7           // R4 - R7 = operand
    LDM 0x8041
    STR 0
    LDM 0x8042
    STR 1
    LDM 0x8043
    STR 2
    LDM 0x8044
    STR 3           // R0 - R3 = accumulator

    LDM 0x8040
    STR 13
    LDI 213         // 256 - 43 -> '+'
    ADD 13
    JA0 calculator_int32__add
    LDI 211         // 256 - 45 -> '-'
    ADD 13
    JA0 calculator_int32__sub
    LDI 214         // 256 - 42 -> '*'
    ADD 13
    JA0 calculator_int32__mul
    LDI 209         // 256 - 47 -> '/'
    ADD 13
    JA0 calculator_int32__div
    JMP calculator_int32__pow

calculator_int32__add:
    CLL int32_add
    JMP calculator_int32__store

calculator_int32__sub:
    CLL int32_sub
    JMP calculator_int32__store

calculator_int32__mul:
    CLL int32_mul
    JMP calculator_int32__store

// calculator_int32__div: klib's int32_div is unsigned, so both operands are
// made positive first and the quotient is negated again if exactly one of
// them was negative
calculator_int32__div:
    LDR 4
    ORR 5
    ORR 6
    ORR 7
    JA0 calculator_int32__err

    LDI 0
    STR 15          // 1 -> the quotient has to be negated
    LDI 128
    STR 12

    LDR 7
    AND 12
    JA0 calculator_int32__div_a
    LDI 1
    STR 15
    LDR 0
    PSH
    LDR 1
    PSH
    LDR 2
    PSH
    LDR 3
    PSH             // park the accumulator
    LDI 0
    STR 0
    STR 1
    STR 2
    STR 3
    CLL int32_sub   // R8 - R11 = 0 - operand
    LDR 8
    STR 4
    LDR 9
    STR 5
    LDR 10
    STR 6
    LDR 11
    STR 7
    POP
    STR 3
    POP
    STR 2
    POP
    STR 1
    POP
    STR 0

calculator_int32__div_a:
    LDI 128
    STR 12
    LDR 3
    AND 12
    JA0 calculator_int32__div_go
    LDI 1
    XOR 15
    STR 15          // both negative -> the quotient stays positive
    LDR 4
    PSH
    LDR 5
    PSH
    LDR 6
    PSH
    LDR 7
    PSH             // park the operand
    LDR 0
    STR 4
    LDR 1
    STR 5
    LDR 2
    STR 6
    LDR 3
    STR 7
    LDI 0
    STR 0
    STR 1
    STR 2
    STR 3
    CLL int32_sub   // R8 - R11 = 0 - accumulator
    LDR 8
    STR 0
    LDR 9
    STR 1
    LDR 10
    STR 2
    LDR 11
    STR 3
    POP
    STR 7
    POP
    STR 6
    POP
    STR 5
    POP
    STR 4

calculator_int32__div_go:
    CLL int32_div   // R8 - R11 = |accumulator| / |operand|
    LDR 15
    JA0 calculator_int32__store
    LDR 8
    STR 4
    LDR 9
    STR 5
    LDR 10
    STR 6
    LDR 11
    STR 7
    LDI 0
    STR 0
    STR 1
    STR 2
    STR 3
    CLL int32_sub   // R8 - R11 = 0 - quotient
    JMP calculator_int32__store

// calculator_int32__pow: the exponent is a repeat count, so a negative one is
// an error
calculator_int32__pow:
    LDI 128
    STR 12
    LDR 7
    AND 12
    JA1 calculator_int32__err
    CLL int32_pow
    JMP calculator_int32__store

// calculator_int32__err: a line that fits no pattern and a result that does
// not exist both leave the accumulator as it was
calculator_int32__err:
    LDI 63          // '?'
    CLL disp_putc
    LDI 69          // 'E'
    CLL disp_putc
    LDI 82          // 'R'
    CLL disp_putc
    LDI 82          // 'R'
    CLL disp_putc
    JMP calculator_int32__next

calculator_int32__store:
    LDR 8
    STM 0x8041
    LDR 9
    STM 0x8042
    LDR 10
    STM 0x8043
    LDR 11
    STM 0x8044

// calculator_int32__print: prints the accumulator but leaves its row open --
// int32_write ends the row, and ending the last one clears the display, which
// is what used to wipe a result the moment it appeared
calculator_int32__print:
    LDM 0x8041
    STR 0
    LDM 0x8042
    STR 1
    LDM 0x8043
    STR 2
    LDM 0x8044
    STR 3
    LDI 61          // '='
    CLL disp_putc
    CLL int32_puts

// calculator_int32__next: the result stays on the display until a key is
// pressed; that key opens the line under it and is then read as its first
calculator_int32__next:
    CLL calculator_int32__read_key
    STR 14
    LDI 129         // 256 - 127 -> DEL, nothing to erase -> ignore it
    ADD 14
    JA0 calculator_int32__next
    LDI 248         // 256 - 8 -> BS, same
    ADD 14
    JA0 calculator_int32__next
    CLL calculator_int32__newline
    LDI 62          // '>'
    CLL disp_putc
    LDI 0
    STM 0x8045
    JMP calculator_int32__char

// calculator_int32__newline: opens the row the next line goes on, clearing the
// display when the line and the result under it would no longer fit
//     clobbers: R13
calculator_int32__newline:
    LDM 0x8022
    STR 13
    LDI 254         // 256 - 2; carry set only on the last two rows
    ADD 13
    JC1 disp_cls    // both end in RET, so both return to this routine's caller
    JMP disp_nl

// calculator_int32__number: reads '[-] digits' at the parse index; like
// int32_mul, a magnitude beyond 32 bit wraps
//     out:      value -> R0 - R3, accumulator = 0, or 1 if there is no number
//     clobbers: R0 - R15
calculator_int32__number:
    LDI 0
    STM 0x8047
    STM 0x8048
    STM 0x8049
    STM 0x804A
    STM 0x804B
    STM 0x804C
    CLL calculator_int32__peek
    STR 13
    LDI 211         // 256 - 45 -> '-'
    ADD 13
    JA1 calculator_int32__number_digit
    LDI 1
    STM 0x8047
    CLL calculator_int32__skip

calculator_int32__number_digit:
    CLL calculator_int32__peek
    CLL calculator_int32__digit
    JA1 calculator_int32__number_end
    LDI 1
    STM 0x8048
    LDM 0x8049
    STR 0
    LDM 0x804A
    STR 1
    LDM 0x804B
    STR 2
    LDM 0x804C
    STR 3
    LDI 10
    STR 4
    LDI 0
    STR 5
    STR 6
    STR 7
    CLL int32_mul
    LDR 8
    STR 0
    LDR 9
    STR 1
    LDR 10
    STR 2
    LDR 11
    STR 3
    LDR 15
    STR 4
    LDI 0
    STR 5
    STR 6
    STR 7
    CLL int32_add
    LDR 8
    STM 0x8049
    LDR 9
    STM 0x804A
    LDR 10
    STM 0x804B
    LDR 11
    STM 0x804C      // magnitude = magnitude * 10 + digit
    CLL calculator_int32__skip
    JMP calculator_int32__number_digit

calculator_int32__number_end:
    LDM 0x8048
    JA0 calculator_int32__number_fail
    LDM 0x8049
    STR 4
    LDM 0x804A
    STR 5
    LDM 0x804B
    STR 6
    LDM 0x804C
    STR 7
    LDI 0
    STR 0
    STR 1
    STR 2
    STR 3
    LDM 0x8047
    JA0 calculator_int32__number_plus
    CLL int32_sub   // R8 - R11 = 0 - magnitude
    LDR 8
    STR 0
    LDR 9
    STR 1
    LDR 10
    STR 2
    LDR 11
    STR 3
    LDI 0
    RET

calculator_int32__number_plus:
    LDR 4
    STR 0
    LDR 5
    STR 1
    LDR 6
    STR 2
    LDR 7
    STR 3
    LDI 0
    RET

calculator_int32__number_fail:
    LDI 1
    RET

// calculator_int32__digit: tells a decimal digit
//     in:       char -> accumulator
//     out:      its value -> R15, accumulator = 0 if it is one, 1 if not
//     clobbers: R12
calculator_int32__digit:
    STR 12
    LDI 208         // 256 - 48; carry set only for chars >= '0'
    ADD 12
    JC0 calculator_int32__digit_no
    STR 15
    LDI 246         // 256 - 10; carry set only for chars > '9'
    ADD 15
    JC1 calculator_int32__digit_no
    LDI 0
    RET

calculator_int32__digit_no:
    LDI 1
    RET

// calculator_int32__peek: the char at the parse index, 0 at the end of the
// line
//     out:      char -> accumulator
//     clobbers: R12, R13
calculator_int32__peek:
    LDM 0x8046
    STR 12
    LDI 0x60
    ADD 12
    STR 12
    LDI 0x80
    STR 13
    JMP mem_peek    // its RET returns to this routine's caller

// calculator_int32__skip: moves the parse index on by one char
//     clobbers: R12
calculator_int32__skip:
    LDM 0x8046
    STR 12
    LDI 1
    ADD 12
    STM 0x8046
    RET

// calculator_int32__read_key: waits for a key press and returns its char
//     out:      char -> accumulator
//     clobbers: R12
calculator_int32__read_key:
    LDR 16
    JA0 calculator_int32__read_key
    LDR 17
    STR 12
    LDI 0
    STR 16          // clear the set-bit -> acknowledge the char
    LDR 12
    RET
