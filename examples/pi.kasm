// Archimedes' polygon, see README.md. Doubling the corner count of a polygon
// with the side s gives
//     s' = s / sqrt(2 + 2 * sqrt(1 - (s/2)^2))
// written so that no two nearly equal values are subtracted; half the
// perimeter is h * s for a polygon of 2h corners.
//
// Scratch memory, above the 0x8000 - 0x803F klib maps in klib/io/disp.kasm:
//     0x8040 - 0x8043 the side s
//     0x8044 - 0x8047 h, half the corner count
//     0x8048 - 0x804B the square root's argument
//     0x804C - 0x804F the square root's running estimate
//     0x8050          doublings left
//     0x8051          square root rounds left
//     0x8054 - 0x8057 1.0
//     0x8058 - 0x805B 2.0
//     0x805C - 0x805F 4.0

    JMP main

.include "../klib/math/float32.kasm"
.include "../klib/io/disp.kasm"
.include "../klib/io/float32_write.kasm"

main:
    LDI 1
    CLL pi__int_to_float
    LDR 8
    STM 0x8054
    STM 0x8040
    LDR 9
    STM 0x8055
    STM 0x8041
    LDR 10
    STM 0x8056
    STM 0x8042
    LDR 11
    STM 0x8057
    STM 0x8043      // 1.0, and the hexagon's side is the radius

    LDI 2
    CLL pi__int_to_float
    LDR 8
    STM 0x8058
    LDR 9
    STM 0x8059
    LDR 10
    STM 0x805A
    LDR 11
    STM 0x805B      // 2.0

    LDI 4
    CLL pi__int_to_float
    LDR 8
    STM 0x805C
    LDR 9
    STM 0x805D
    LDR 10
    STM 0x805E
    LDR 11
    STM 0x805F      // 4.0

    LDI 3
    CLL pi__int_to_float
    LDR 8
    STM 0x8044
    LDR 9
    STM 0x8045
    LDR 10
    STM 0x8046
    LDR 11
    STM 0x8047      // the hexagon's six corners, counted in halves

    LDI 10
    STM 0x8050

pi__loop:
    LDM 0x8040
    STR 0
    LDM 0x8041
    STR 1
    LDM 0x8042
    STR 2
    LDM 0x8043
    STR 3
    CLL pi__a_to_b
    CLL float32_mul // s^2

    CLL pi__c_to_a
    LDM 0x805C
    STR 4
    LDM 0x805D
    STR 5
    LDM 0x805E
    STR 6
    LDM 0x805F
    STR 7
    CLL float32_div // (s/2)^2

    CLL pi__c_to_b
    LDM 0x8054
    STR 0
    LDM 0x8055
    STR 1
    LDM 0x8056
    STR 2
    LDM 0x8057
    STR 3
    CLL float32_sub
    CLL pi__c_to_a
    CLL pi__sqrt    // the center's distance from the edge

    CLL pi__c_to_a
    CLL pi__c_to_b
    CLL float32_add // twice that
    CLL pi__c_to_b
    LDM 0x8058
    STR 0
    LDM 0x8059
    STR 1
    LDM 0x805A
    STR 2
    LDM 0x805B
    STR 3
    CLL float32_add
    CLL pi__c_to_a
    CLL pi__sqrt

    CLL pi__c_to_b
    LDM 0x8040
    STR 0
    LDM 0x8041
    STR 1
    LDM 0x8042
    STR 2
    LDM 0x8043
    STR 3
    CLL float32_div // the doubled polygon's side
    LDR 8
    STM 0x8040
    LDR 9
    STM 0x8041
    LDR 10
    STM 0x8042
    LDR 11
    STM 0x8043

    LDM 0x8044
    STR 0
    LDM 0x8045
    STR 1
    LDM 0x8046
    STR 2
    LDM 0x8047
    STR 3
    CLL pi__a_to_b
    CLL float32_add // twice as many corners
    LDR 8
    STM 0x8044
    LDR 9
    STM 0x8045
    LDR 10
    STM 0x8046
    LDR 11
    STM 0x8047

    CLL pi__c_to_a  // float32_add left h in R8 - R11 only
    LDM 0x8040
    STR 4
    LDM 0x8041
    STR 5
    LDM 0x8042
    STR 6
    LDM 0x8043
    STR 7
    CLL float32_mul // half the perimeter
    CLL pi__c_to_a
    CLL float32_write

    LDM 0x8050
    STR 12
    LDI 255
    ADD 12
    STM 0x8050
    JA1 pi__loop

pi__halt:
    JMP pi__halt

// pi__sqrt: Newton's iteration x = (x + a/x) / 2, run six times from a start
// of 2, which reaches single precision for the arguments here (all of them
// lie between 0.75 and 4)
//     in:       a -> R0 - R3
//     out:      sqrt(a) -> R8 - R11
//     clobbers: R0 - R15, 0x8048 - 0x8051
pi__sqrt:
    LDR 0
    STM 0x8048
    LDR 1
    STM 0x8049
    LDR 2
    STM 0x804A
    LDR 3
    STM 0x804B
    LDM 0x8058
    STM 0x804C
    LDM 0x8059
    STM 0x804D
    LDM 0x805A
    STM 0x804E
    LDM 0x805B
    STM 0x804F      // the first estimate is 2
    LDI 6
    STM 0x8051

pi__sqrt__loop:
    LDM 0x8048
    STR 0
    LDM 0x8049
    STR 1
    LDM 0x804A
    STR 2
    LDM 0x804B
    STR 3
    LDM 0x804C
    STR 4
    LDM 0x804D
    STR 5
    LDM 0x804E
    STR 6
    LDM 0x804F
    STR 7
    CLL float32_div // a / x

    CLL pi__c_to_b
    LDM 0x804C
    STR 0
    LDM 0x804D
    STR 1
    LDM 0x804E
    STR 2
    LDM 0x804F
    STR 3
    CLL float32_add // x + a / x

    CLL pi__c_to_a
    LDM 0x8058
    STR 4
    LDM 0x8059
    STR 5
    LDM 0x805A
    STR 6
    LDM 0x805B
    STR 7
    CLL float32_div
    LDR 8
    STM 0x804C
    LDR 9
    STM 0x804D
    LDR 10
    STM 0x804E
    LDR 11
    STM 0x804F

    LDM 0x8051
    STR 12
    LDI 255
    ADD 12
    STM 0x8051
    JA1 pi__sqrt__loop
    RET             // R8 - R11 still hold the estimate

// pi__int_to_float: the single precision value of a small integer
//     in:       n -> accumulator (0 - 255)
//     out:      n as a single precision value -> R8 - R11
//     clobbers: R0 - R3, R12 - R15
pi__int_to_float:
    STR 0
    LDI 0
    STR 1
    STR 2
    STR 3
    CLL float32_from_int32
    RET

// pi__a_to_b: copies the first operand to the second
pi__a_to_b:
    LDR 0
    STR 4
    LDR 1
    STR 5
    LDR 2
    STR 6
    LDR 3
    STR 7
    RET

// pi__c_to_a: moves the result of the last klib call to the first operand
pi__c_to_a:
    LDR 8
    STR 0
    LDR 9
    STR 1
    LDR 10
    STR 2
    LDR 11
    STR 3
    RET

// pi__c_to_b: moves the result of the last klib call to the second operand
pi__c_to_b:
    LDR 8
    STR 4
    LDR 9
    STR 5
    LDR 10
    STR 6
    LDR 11
    STR 7
    RET
