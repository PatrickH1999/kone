main:
    LDI 32      // first visible char (space)
    STR 0

    LDI 129     // 256 - 127, used below to test "R0 == 127" via overflow
    STR 1

loop:
    LDR 0
    STR 19      // REG_ID_DISP_CHAR
    LDI 1
    STR 18      // REG_ID_DISP_SET

    // The display runs beside the cpu and only looks at the two registers
    // every so often, so the next char may not be written before it has taken
    // this one; it clears the set-bit to say so. This is the same handshake
    // that 'disp_putc' in klib/io/disp.kasm does.
display__wait:
    LDR 18
    JA1 display__wait

    LDI 1
    ADD 0       // A = R0 + 1
    STR 0

    LDR 0
    ADD 1       // A = R0 + 129; wraps to 0 only when R0 == 127 (DEL)
    JA0 wrap
    JMP loop

wrap:
    LDI 32      // last visible char was 126 ('~'), so cycle back to 32
    STR 0
    JMP loop
