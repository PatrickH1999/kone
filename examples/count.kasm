// count: counts up in R0 - R3 and prints every value to the display as a
// decimal number, one per row. The counter is a 32 bit signed integer, so it
// runs from 0 up to 2147483647 and then wraps around to -2147483648.
//
// Both halves of the loop are klib routines: 'int32_add' from klib/math.kasm
// does the counting and 'int32_write' from klib/io.kasm the printing, which
// is why every row is prefixed with '=' the way int32_write always prints.
// The two class includes below pull in all of klib; a program that wants no
// more than this one needs can include klib/io/disp.kasm, klib/math/int32.kasm
// and klib/io/int32_write.kasm instead.

    JMP main

.include "../klib/math.kasm"
.include "../klib/io.kasm"

main:
    LDI 0
    STR 0
    STR 1
    STR 2
    STR 3           // the counter, byte order LSB -> MSB

loop:
    CLL int32_write // R0 - R3 survive the call, R4 - R15 do not

    LDI 1
    STR 4
    LDI 0
    STR 5
    STR 6
    STR 7           // the summand, 1
    CLL int32_add   // R8 - R11 = counter + 1

    LDR 8
    STR 0
    LDR 9
    STR 1
    LDR 10
    STR 2
    LDR 11
    STR 3           // counter = R8 - R11
    JMP loop
