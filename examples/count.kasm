    JMP main

.include "../klib/math.kasm"
.include "../klib/io.kasm"

main:
    LDI 0
    STR 0
    STR 1
    STR 2
    STR 3           // the counter, byte order LSB -> MSB

loop:
    CLL int32_write // R0 - R3 survive the call, R4 - R15 do not

    LDI 1
    STR 4
    LDI 0
    STR 5
    STR 6
    STR 7           // the summand, 1
    CLL int32_add   // R8 - R11 = counter + 1

    LDR 8
    STR 0
    LDR 9
    STR 1
    LDR 10
    STR 2
    LDR 11
    STR 3           // counter = R8 - R11
    JMP loop
